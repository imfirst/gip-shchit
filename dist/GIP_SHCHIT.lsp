      (gip:PL (list (+ OX 4137.8) (+ OY *gip:YB_N*) (+ OX 4137.8) (+ OY yb)) "ln_Nbot")
      (gip:PL (list (+ OX xi) (+ OY yb) (+ OX xi) (+ OY *gip:YB_L*)) "ln_Lbot")
      (gip:PL (list (+ OX 4302.6) (+ OY *gip:YB_PE*) (+ OX 4302.6) (+ OY (if (gip:g S "floorShield") 939.0 yb))) "ln_PE")
      (gip:dot (+ OX xi) (+ OY *gip:YB_L*) T) (gip:dot (+ OX 4137.8) (+ OY *gip:YB_N*) T) (gip:dot (+ OX 4302.6) (+ OY *gip:YB_PE*) T)
      (if km
        (progn
          (setq ks (gip:km-split (gip:gn km "model" "")) k1 (car ks) k2 (cadr ks))
          (gip:place (if is3 "km3" "km1") OX OY '(lambda (its) (mapcar '(lambda (it / t1) (setq t1 (if (= (car it) "E") (gip:it-get it 1)))
                                                                               (cond ((= t1 "ESB") (gip:it-set it 1 k1)) ((= t1 "63-40N") (gip:it-set it 1 k2)) (T it))) its)))
          (gip:place "kmname" OX OY nil)))
      ;; ---- показатели
      (setq Kc (gip:gn S "kc" 0.4) LNS (gip:g BRD "lines"))
      (setq spw (gip:sum (mapcar '(lambda (l) (gip:g l "p")) LNS)))
      (setq sqv (gip:sum (mapcar '(lambda (l) (/ (gip:g l "p") (gip:cos l))) LNS)))
      (setq cosl (if (> sqv 0) (/ (gip:round (* (/ spw sqv) 100)) 100.0) 0.9))
      (setq ph (list (cons "A" 0.0) (cons "B" 0.0) (cons "C" 0.0)))
      (foreach l LNS
        (cond ((not is3) (setq ph (gip:s ph "A" (+ (gip:g ph "A") (gip:g l "p")))))
              ((= (gip:g l "phase") "L123") (foreach q '("A" "B" "C") (setq ph (gip:s ph q (+ (gip:g ph q) (/ (gip:g l "p") 3.0))))))
              (T (setq q (cdr (assoc (gip:g l "phase") '(("L1" . "A") ("L2" . "B") ("L3" . "C")))))
                 (setq ph (gip:s ph q (+ (gip:g ph q) (gip:g l "p")))))))
      (setq PRAS (* spw Kc) Ip (if is3 (/ PRAS (* (sqrt 3.0) 0.4 cosl)) (/ PRAS (* 0.23 cosl))))
      ;; таблица по фазам: при одной фазе — только столбец A без заголовка
      (setq phs (if is3 '("A" "B" "C") '("A")))
      (setq tx (+ OX 8400.0) ty (+ OY 3550.0) kk2 *gip:KU* w1 (* (if is3 85 41) kk2) hh (* 34 kk2) px2 (+ tx w1) w2 (* 118 kk2) HD 500.0 hh2 (+ HD (* 30 kk2)))
      (gip:PL (list tx ty (+ px2 w2) ty (+ px2 w2) (- ty hh2) tx (- ty hh2) tx ty) nil)
      (gip:PL (list tx (- ty HD) (+ tx w1) (- ty HD)) nil)
      (gip:PL (list px2 ty px2 (- ty hh2)) nil)
      (foreach mm (if is3 '(19 41 63) '(19)) (gip:PL (list (+ tx (* mm kk2)) ty (+ tx (* mm kk2)) (- ty hh2)) nil))
      (foreach mm '(10 20) (gip:PL (list tx (- ty HD (* mm kk2)) (+ tx w1) (- ty HD (* mm kk2))) nil))
      (setq ii 0)
      (if is3 (foreach t1 $Q145 (gip:ol-cell (+ tx (* (+ 30 (* ii 22)) kk2)) (- ty (/ HD 2)) t1 nil) (setq ii (1+ ii))))
      (foreach r (list $Q146 $Q147 $Q148) (gip:ol-cell (+ tx (* 9.5 kk2)) (- ty HD (* (cdr r) kk2)) (car r) nil))
      (setq ii 0)
      (foreach pp phs
        (setq xx (+ tx (* (+ 30 (* ii 22)) kk2)) on (member pp phs))
        (gip:ol-cell xx (- ty HD (* 5 kk2)) (if on (gip:f1 (gip:g ph pp)) $S149) nil)
        (gip:ol-cell xx (- ty HD (* 15 kk2)) (if on (gip:f1 (* (gip:g ph pp) Kc)) $S149) nil)
        (gip:ol-cell xx (- ty HD (* 25 kk2)) (if on (gip:f1 (/ (* (gip:g ph pp) Kc) (* 0.23 cosl))) $S149) nil)
        (setq ii (1+ ii)))
      (gip:mt "cell_qty" (+ px2 (/ w2 2)) (- ty (/ HD 2)) $S150 (list (cons "w" 5889.026) (cons "att" 5)))
      (setq rows (list (cons $S151 (if is3 "400/230" "230")) (cons $S152 (gip:f1 spw))
                       (cons $S153 (gip:f1 PRAS)) (cons $S154 (gip:f1 Ip))
                       (cons $S155 (gip:fmtz Kc 2)) (cons $S156 (gip:fmtz cosl 2))))
      (setq ii 0)
      (foreach rw rows
        (setq yy (- ty HD (* ii 5 kk2)))
        (gip:PL (list px2 yy (+ px2 w2) yy) nil)
        (gip:ol-cell (+ px2 (* 1.5 kk2)) (- yy (* 2.5 kk2)) (car rw) T)
        (gip:ol-cell (+ px2 (* 107.5 kk2)) (- yy (* 2.5 kk2)) (cdr rw) nil)
        (setq ii (1+ ii)))))
  ;; ---- шина освещения
  (setq lb (vl-remove-if-not '(lambda (c) (and (= (gip:g c "t") "line") (= (gip:g (gip:g c "d") "feed") "km"))) sc))
  (if (and isfirst km lb)
    (progn (setq lxx (+ *gip:C0* (* (gip:index (last lb) sc) *gip:PITCH*)))
           (gip:PL (list (+ OX 3053.5) (+ OY *gip:YB_LB*) (+ OX lxx) (+ OY *gip:YB_LB*)) "lightbus")))
  ;; ---- колонки
  (setq rcdBus nil ci 0)
  (foreach c sc
    (setq x (+ *gip:C0* (* ci *gip:PITCH*)) AX (+ OX x) d (gip:g c "d") l (gip:g d "line"))
    (gip:PL (list (- AX 392.7) (+ OY (nth 0 *gip:YT*)) (- AX 392.7) (+ OY (nth 4 *gip:YT*))) nil)
    (if is3
      (progn
        (setq pl (if (= (gip:g c "t") "rcd")
                   (if (= (gip:g d "w") 4) "ABC" (gip:gn (list '("L1" . "A") '("L2" . "B") '("L3" . "C")) (gip:g d "phase") ""))
                   (if (or (= (gip:g d "phase") "L123") (member (gip:g d "kind") '("a3" "dif4"))) "ABC"
                     (gip:gn (list '("L1" . "A") '("L2" . "B") '("L3" . "C")) (gip:g d "phase") ""))))
        (gip:mt "m_phase" (- AX (if (> (strlen pl) 1) 316.0 135.5)) (- OY 1868.0) pl nil)))
    (if (= (gip:g c "t") "rcd")
      (progn
        (setq members (vl-remove-if-not '(lambda (m) (= (gip:g (gip:g m "d") "feed") (gip:g d "id"))) sc))
        (setq xe (+ OX *gip:C0* (* (gip:index (last members) sc) *gip:PITCH*)) yL -1712.0 yN -1782.0)
        (gip:dot AX (+ OY *gip:YB_L*) nil) (gip:dot (+ AX 165) (+ OY *gip:YB_N*) nil)
        (gip:W AX (+ OY *gip:YB_L*) AX (+ OY *gip:YDEV*)) (gip:W (+ AX 165) (+ OY *gip:YB_N*) (+ AX 165) (+ OY *gip:YDEV*))
        (setq rr d)
        (gip:place "dev_d1" AX (+ OY *gip:YDEV*) $Q157)
        (gip:W AX (+ OY *gip:YDB*) AX (- OY 2700.0)) (gip:W AX (- OY 2700.0) (+ AX 250) (- OY 2700.0)) (gip:W (+ AX 250) (- OY 2700.0) (+ AX 250) (+ OY yL))
        (gip:W (+ AX 165) (+ OY *gip:YDB*) (+ AX 165) (- OY 2655.0)) (gip:W (+ AX 165) (- OY 2655.0) (+ AX 330) (- OY 2655.0)) (gip:W (+ AX 330) (- OY 2655.0) (+ AX 330) (+ OY yN))
        (gip:PL (list (+ AX 250) (+ OY yL) xe (+ OY yL)) "lightbus")
        (gip:W (+ AX 330) (+ OY yN) (+ xe 165) (+ OY yN))
        (setq rcdBus (cons (cons (gip:g d "id") (list yL yN)) rcdBus))
        (gip:mt "cell_qty" AX (- OY 4845.0) $S149 (list (cons "w" 700.0))))
      (progn
        (setq srcY *gip:YB_L* vr (cdr (assoc (gip:g d "feed") rcdBus)))
        (if (and (= (gip:g d "feed") "km") km) (setq srcY *gip:YB_LB*))
        (if vr (setq srcY (car vr)))
        (setq nY (if vr (cadr vr) *gip:YB_N*) isD (member (gip:g d "kind") '("dif" "dif4")))
        (setq proto (cond ((= (gip:g d "kind") "dif4") "dev_d3") ((= (gip:g d "kind") "dif") "dev_d1") ((= (gip:g d "kind") "a3") "dev_a3") (T "dev_a1")))
        (gip:dot AX (+ OY srcY) nil) (gip:dot (+ AX 165) (+ OY nY) nil) (gip:dot (+ AX 266) (+ OY *gip:YB_PE*) nil)
        (gip:W AX (+ OY srcY) AX (+ OY *gip:YDEV*)) (gip:W (+ AX 165) (+ OY nY) (+ AX 165) (+ OY *gip:YDEV*))
        (setq tk (gip:g d "kind") rr d)
        (gip:place proto AX (+ OY *gip:YDEV*)
          $Q158)
        (gip:W (+ AX 165) (+ OY *gip:YDB*) (+ AX 165) (+ OY *gip:YKN*)) (gip:W (+ AX 165) (+ OY *gip:YKN*) AX (+ OY *gip:YMG*))
        (gip:W (+ AX 266) (+ OY *gip:YB_PE*) (+ AX 266) (+ OY *gip:YKN*)) (gip:W (+ AX 266) (+ OY *gip:YKN*) AX (+ OY *gip:YMG*))
        (if (not (gip:g l "reserve"))
          (progn
            (setq cs (gip:consumer l))
            (gip:W AX (+ OY *gip:YDB*) AX (+ OY (caddr cs)))
            (setq rr (list c l))
            (gip:place (car cs) AX (+ OY (cadr cs))
              $Q159)
            (gip:mt "m_cable" (- AX 157.0) (- OY 4195.5) (strcat (gip:mark-short (gip:gn S "mark" $S98)) " " (gip:repl (gip:g l "cable") $S94 "x")) nil)
            ;; длина кабеля на схеме — по галочке «Длины кабелей на схеме»
            (gip:mt "m_cond" (+ AX 64.0) (- OY 4195.5) (strcat (gip:conduit (gip:g l "cable")) (if (gip:g S "olLen") (strcat " L=" (itoa (gip:g l "len")) $S160) "")) nil)))
        (gip:mt "cell_qty" AX (- OY 4845.0) (gip:g c "no") (list (cons "w" 700.0)))
        (gip:mt "cell_qty" AX (- OY 5293.0) (gip:f1 (gip:g l "p")) (list (cons "w" 700.0)))
        (gip:mt "cell_qty" AX (- OY 5591.0) (gip:f1 (gip:inom l)) (list (cons "w" 700.0)))
        (setq nmt (gip:take (gip:wrap (if (gip:starts (gip:g l "name") $S65) (strcat $S161 (substr (gip:g l "name") 12)) (gip:g l "name")) 16) 3))
        (gip:mt "m_name" (+ (- AX 300.0) (if (= (length nmt) 1) 120.0 0.0)) (- OY 7022.0) (gip:join nmt "\n") (list (cons "w" 1282.0)))))
    (setq ci (1+ ci)))
  ;; ---- КУП
  (if (and islast kup)
    (progn
      (setq AXk (+ OX *gip:C0* (* (length sc) *gip:PITCH*)))
      (gip:PL (list (- AXk 392.7) (+ OY (nth 0 *gip:YT*)) (- AXk 392.7) (+ OY (nth 4 *gip:YT*))) nil)
      (gip:dot AXk (+ OY *gip:YB_PE*) nil) (gip:W AXk (+ OY *gip:YB_PE*) AXk (- OY 4360.5))
      (gip:place "kup" AXk OY
        $Q162)))
  ;; ---- штамп
  (gip:stamp-st OX OY title (itoa (+ 2 si)) "")
  title)

(defun gip:ol-cell (x y txt left)
