;;; ============================================================================
;;; Трассы на планах ЭОМ: автоматическая прорисовка кабельных линий от щита до розеток (силовые сети).
;;; Исходные данные: контуры помещений (слой GIP_ПОМ_КОНТУР), блоки ЭОМ_Розетки_GIP, точка щита.
;;; Правила (по эталонным чертежам):
;;;   • всё ортогонально в системе координат стен (план может быть повёрнут);
;;;   • магистраль шириной 40 — участки, общие для двух и более помещений, ответвления шириной 10;
;;;   • в помещение трасса входит к ближайшей розетке, дальше цепочка по кромке стены от розетки к ближайшей и т.д.;
;;;   • линии красные, слой GIP_ТРАССЫ_СИЛ (перед перестроением стираются только они).
;;; Ядро (gip:rt-build) работает с точками и ничего не знает о чертеже, поэтому проверяется в имитаторе.
;;; ============================================================================
(setq *gip:rt-lay-p* "GIP_ТРАССЫ_СИЛ" *gip:rt-step* 200.0 *gip:rt-touch* nil *gip:rt-td* nil
      *gip:rt-nx* 0 *gip:rt-ny* 0 *gip:rt-x0* 0.0 *gip:rt-y0* 0.0 *gip:rt-g* 200.0)

;; ---------------------------------------------------------------- «хеш» на символах (быстрый доступ по числовому ключу)
(defun gip:rt-sym (p k) (read (strcat p (itoa k))))
(defun gip:rt-g (p k) (eval (gip:rt-sym p k)))
(defun gip:rt-s (p k v / sm)
  (setq sm (gip:rt-sym p k))
  (if (null (eval sm)) (setq *gip:rt-touch* (cons sm *gip:rt-touch*)))
  (set sm v))
(defun gip:rt-sd (p k v / sm)
  (setq sm (gip:rt-sym p k))
  (if (null (eval sm)) (setq *gip:rt-td* (cons sm *gip:rt-td*)))
  (set sm v))
(defun gip:rt-free-d () (foreach sm *gip:rt-td* (set sm nil)) (setq *gip:rt-td* nil))
(defun gip:rt-free () (gip:rt-free-d) (foreach sm *gip:rt-touch* (set sm nil)) (setq *gip:rt-touch* nil))

;; ---------------------------------------------------------------- геометрия
(defun gip:rt-pip (x y pts / n i j in a b)
  (setq n (length pts) i 0 j (1- n) in nil)
  (while (< i n)
    (setq a (nth i pts) b (nth j pts))
    (if (and (/= (if (> (cadr a) y) 1 0) (if (> (cadr b) y) 1 0))
             (< x (+ (car a) (/ (* (- (car b) (car a)) (- y (cadr a))) (- (cadr b) (cadr a))))))
      (setq in (not in)))
    (setq j i i (1+ i)))
  in)
;; проекция точки на отрезок: (u qx qy)
(defun gip:rt-proj (x y a b / dx dy l2 u)
  (setq dx (- (car b) (car a)) dy (- (cadr b) (cadr a)) l2 (+ (* dx dx) (* dy dy)))
  (setq u (if (> l2 0.000001) (/ (+ (* (- x (car a)) dx) (* (- y (cadr a)) dy)) l2) 0.0))
  (setq u (max 0.0 (min 1.0 u)))
  (list u (+ (car a) (* u dx)) (+ (cadr a) (* u dy))))
;; ближайшая точка контура: (расстояние номер-ребра u qx qy)
(defun gip:rt-near (x y pts / n i p d best)
  (setq n (length pts) i 0 best nil)
  (while (< i n)
    (setq p (gip:rt-proj x y (nth i pts) (nth (rem (1+ i) n) pts)) d (distance (list x y) (cdr p)))
    (if (or (null best) (< d (car best))) (setq best (list d i (car p) (cadr p) (caddr p))))
    (setq i (1+ i)))
  best)
;; преобладающий угол стен (по модулю 90°), взвешенный по длине рёбер
(defun gip:rt-angle (polys / sc ss n i a b l an)
  (setq sc 0.0 ss 0.0)
  (foreach pts polys
    (setq n (length pts) i 0)
    (while (< i n)
      (setq a (nth i pts) b (nth (rem (1+ i) n) pts) l (distance a b))
      (if (> l 0.001)
        (progn (setq an (angle a b))
               (setq sc (+ sc (* l (cos (* 4.0 an)))) ss (+ ss (* l (sin (* 4.0 an)))))))
      (setq i (1+ i))))
  (if (and (< (abs sc) 0.000001) (< (abs ss) 0.000001)) 0.0 (/ (atan ss sc) 4.0)))
(defun gip:rt-to-loc (p o an)
  (list (+ (* (- (car p) (car o)) (cos an)) (* (- (cadr p) (cadr o)) (sin an)))
        (- (* (- (cadr p) (cadr o)) (cos an)) (* (- (car p) (car o)) (sin an)))))
(defun gip:rt-to-glob (p o an)
  (list (+ (car o) (- (* (car p) (cos an)) (* (cadr p) (sin an))))
        (+ (cadr o) (+ (* (car p) (sin an)) (* (cadr p) (cos an))))))
;; убрать повторы и промежуточные точки на прямой
(defun gip:rt-simplify (pts / r a b c)
  (setq r nil)
  (foreach p pts (if (or (null r) (> (distance p (car r)) 1.0)) (setq r (cons p r))))
  (setq r (reverse r) pts r r nil)
  (foreach p pts
    (setq r (cons p r))
    (while (and (>= (length r) 3)
                (progn (setq c (car r) b (cadr r) a (caddr r))
                       (< (abs (- (* (- (car b) (car a)) (- (cadr c) (cadr a))) (* (- (cadr b) (cadr a)) (- (car c) (car a)))))
                          (* 0.0001 (+ 1.0 (distance a c) (distance a b))))))
      (setq r (cons c (cddr r)))))
  (reverse r))
;; привязка конца линии к розетке: последний прямой участок сдвигается на линию розетки, затем добавляется сама точка
(defun gip:rt-snap-end (pts s / n a b c ax)
  (setq pts (gip:rt-simplify pts) n (length pts))
  (if (< n 2) (list s)
    (progn
      (setq a (nth (- n 2) pts) b (last pts))
      (setq ax (if (< (abs (- (car a) (car b))) (abs (- (cadr a) (cadr b)))) 0 1))   ; 0 — вертикальный участок (x постоянен)
      (if (= ax 0)
        (if (< (abs (- (car b) (car s))) 150.0)
          (setq pts (append (reverse (cddr (reverse pts))) (list (list (car s) (cadr a)) (list (car s) (cadr b)))))
          (setq pts (append pts (list (list (car s) (cadr b))))))
        (if (< (abs (- (cadr b) (cadr s))) 150.0)
          (setq pts (append (reverse (cddr (reverse pts))) (list (list (car a) (cadr s)) (list (car b) (cadr s)))))
          (setq pts (append pts (list (list (car b) (cadr s)))))))
      (gip:rt-simplify (append pts (list s))))))

;; ---------------------------------------------------------------- сетка и поиск пути
(defun gip:rt-cx (ix) (+ *gip:rt-x0* (* (+ ix 0.5) *gip:rt-g*)))
(defun gip:rt-cy (iy) (+ *gip:rt-y0* (* (+ iy 0.5) *gip:rt-g*)))
(defun gip:rt-ci (ix iy) (+ (* ix *gip:rt-ny*) iy))
(defun gip:rt-cpt (ci) (list (gip:rt-cx (/ ci *gip:rt-ny*)) (gip:rt-cy (rem ci *gip:rt-ny*))))
;; помещение клетки: 1+номер контура (внутри или рядом со стеной) или 0
(defun gip:rt-classify (polys bbs x y tol / i r bd d bb inside)
  (setq i 0 r 0 bd 1.0e99 inside nil)
  (foreach pts polys
    (setq bb (nth i bbs) i (1+ i))
    (if (and (null inside) (> x (- (car bb) tol)) (< x (+ (caddr bb) tol)) (> y (- (cadr bb) tol)) (< y (+ (cadddr bb) tol)))
      (if (gip:rt-pip x y pts)
        (setq r i inside T)
        (progn (setq d (car (gip:rt-near x y pts)))
               (if (and (< d tol) (< d bd)) (setq bd d r i))))))
  r)
(defun gip:rt-bbox (pts)
  (list (apply 'min (mapcar 'car pts)) (apply 'min (mapcar 'cadr pts)) (apply 'max (mapcar 'car pts)) (apply 'max (mapcar 'cadr pts))))
;; ближайшая свободная клетка к точке (в окрестности из 7x7), при возможности из помещения room
(defun gip:rt-goal-cell (p room / ix iy dx dy ci best bd d rr pass)
  (setq best nil bd 1.0e99 pass 0)
  (while (and (null best) (< pass 2))
    (setq ix (fix (/ (- (car p) *gip:rt-x0*) *gip:rt-g*)) iy (fix (/ (- (cadr p) *gip:rt-y0*) *gip:rt-g*)) dx -3)
    (while (<= dx 3)
      (setq dy -3)
      (while (<= dy 3)
        (if (and (>= (+ ix dx) 0) (< (+ ix dx) *gip:rt-nx*) (>= (+ iy dy) 0) (< (+ iy dy) *gip:rt-ny*))
          (progn
            (setq ci (gip:rt-ci (+ ix dx) (+ iy dy)) rr (gip:rt-g "GRT_R" ci))
            (if (and rr (> rr 0) (or (= pass 1) (= rr room)))
              (progn (setq d (distance p (gip:rt-cpt ci)))
                     (if (< d bd) (setq bd d best ci))))))
        (setq dy (1+ dy)))
      (setq dx (1+ dx)))
    (setq pass (1+ pass)))
  best)
;; Дейкстра с поправкой на повороты и переходы между помещениями; состояние = клетка*4 + направление.
;; Возвращает последнее состояние (клетка цели) или nil; пути хранятся в GRT_P.
(defun gip:rt-dij (srcs / c pend d s ci ix iy nd nix niy nci ri add nc old items hit r0 ds)
  (gip:rt-free-d)
  (setq pend 0)
  (foreach cl srcs
    (setq d 0)
    (while (< d 4)
      (setq s (+ (* cl 4) d))
      (gip:rt-sd "GRT_D" s 0) (gip:rt-sd "GRT_P" s -1)
      (gip:rt-sd "GRT_B" 0 (cons s (gip:rt-g "GRT_B" 0)))
      (setq pend (1+ pend) d (1+ d))))
  (setq c 0 hit nil)
  (while (and (> pend 0) (null hit))
    (setq items (gip:rt-g "GRT_B" c))
    (set (gip:rt-sym "GRT_B" c) nil)
    (foreach s items
      (setq pend (1- pend))
      (if (and (null hit) (= (gip:rt-g "GRT_D" s) c))
        (progn
          (setq ci (/ s 4) d (rem s 4))
          (if (gip:rt-g "GRT_T" ci)
            (setq hit s)
            (progn
              (setq ix (/ ci *gip:rt-ny*) iy (rem ci *gip:rt-ny*) r0 (gip:rt-g "GRT_R" ci) nd 0)
              (while (< nd 4)
                (if (/= nd (rem (+ d 2) 4))
                  (progn
                    (setq nix (+ ix (cond ((= nd 0) 1) ((= nd 2) -1) (T 0)))
                          niy (+ iy (cond ((= nd 1) 1) ((= nd 3) -1) (T 0))))
                    (if (and (>= nix 0) (< nix *gip:rt-nx*) (>= niy 0) (< niy *gip:rt-ny*))
                      (progn
                        (setq nci (gip:rt-ci nix niy) ri (gip:rt-g "GRT_R" nci))
                        (if (and ri (> ri 0))
                          (progn
                            (setq add (+ 10 (if (/= nd d) 25 0) (if (/= ri r0) 250 0) (if (and (gip:rt-g "GRT_W" nci) (null (gip:rt-g "GRT_T" nci))) 8 0)) nc (+ c add)
                                  ds (+ (* nci 4) nd) old (gip:rt-g "GRT_D" ds))
                            (if (or (null old) (< nc old))
                              (progn
                                (gip:rt-sd "GRT_D" ds nc) (gip:rt-sd "GRT_P" ds s)
                                (gip:rt-sd "GRT_B" nc (cons ds (gip:rt-g "GRT_B" nc)))
                                (setq pend (1+ pend))))))))))
                (setq nd (1+ nd))))))))
    (setq c (1+ c)))
  hit)
(defun gip:rt-path-cells (s / r)
  (setq r nil)
  (while (and s (>= s 0))
    (setq r (cons (/ s 4) r) s (gip:rt-g "GRT_P" s)))
  r)

;; ---------------------------------------------------------------- цепочка розеток по кромке стены
(defun gip:rt-cum (pts / n i r s)
  (setq n (length pts) i 0 s 0.0 r nil)
  (while (< i n)
    (setq r (cons s r) s (+ s (distance (nth i pts) (nth (rem (1+ i) n) pts))) i (1+ i)))
  (list (reverse r) s))
(defun gip:rt-pmod (x l / r) (setq r (- x (* l (fix (/ x l))))) (if (< r 0.0) (+ r l) r))
;; путь по контуру от позиции s1 к s2 (кратчайшее направление): точки-вершины между ними
(defun gip:rt-walk (pts cs L s1 s2 / df r fw k v)
  (setq df (gip:rt-pmod (- s2 s1) L) fw (<= df (- L df)) r nil k 0)
  (foreach cv cs
    (setq v (if fw (gip:rt-pmod (- cv s1) L) (gip:rt-pmod (- s1 cv) L)))
    (if (and (> v 0.001) (< v (if fw df (- L df)))) (setq r (cons (cons v (nth k pts)) r)))
    (setq k (1+ k)))
  (mapcar 'cdr (vl-sort r '(lambda (a b) (< (car a) (car b))))))
;; цепочка по розеткам комнаты, начиная с розетки first; socks — список точек
(defun gip:rt-chain (pts socks st / cc cs L info rest cur res nxt best bd d s1 s2 q1 q2 inf)
  (setq cc (gip:rt-cum pts) cs (car cc) L (cadr cc) info nil)
  (foreach p socks
    (setq inf (gip:rt-near (car p) (cadr p) pts))
    (setq info (cons (list p (list (nth 3 inf) (nth 4 inf)) (+ (nth (nth 1 inf) cs) (* (nth 2 inf) (distance (nth (nth 1 inf) pts) (nth (rem (1+ (nth 1 inf)) (length pts)) pts)))) (car inf)) info)))
  (setq info (reverse info))
  (setq cur (nth st info) rest (vl-remove cur info) res (list (car cur)))
  (if (> (nth 3 cur) 1.0) (setq res (append res (list (cadr cur)))))
  (while rest
    (setq best nil bd 1.0e99)
    (foreach r rest
      (setq d (abs (- (nth 2 r) (nth 2 cur))) d (min d (- L d)))
      (if (< d bd) (setq bd d best r)))
    (setq res (append res (gip:rt-walk pts cs L (nth 2 cur) (nth 2 best))))
    (setq res (append res (list (cadr best))))
    (if (> (nth 3 best) 1.0) (setq res (append res (list (car best)))))
    (setq rest (vl-remove best rest) cur best))
  (gip:rt-simplify res))

;; ---------------------------------------------------------------- ядро: силовые сети
;; Полилинии одного подключения: путь клеток (от сети до розетки) режется на участки по нагрузке (магистраль 40 / ответвление 10)
(defun gip:rt-seg-lines (cells startp sockp / i wid u run runs res pts n)
  (setq i 1 run (list (car cells)) wid nil runs nil)
  (while (< i (length cells))
    (setq u (if (>= (gip:rt-g "GRT_U" (nth i cells)) 2) 40 10))
    (if (and wid (/= u wid))
      (progn (setq runs (cons (cons wid (reverse run)) runs) run (list (nth (1- i) cells)))))
    (setq wid u run (cons (nth i cells) run) i (1+ i)))
  (if (null wid) (setq wid 10))
  (setq runs (reverse (cons (cons wid (reverse run)) runs)) res nil n (length runs) i 0)
  (foreach rn runs
    (setq pts (mapcar 'gip:rt-cpt (cdr rn)))
    (if (and (= i 0) startp) (setq pts (reverse (gip:rt-snap-end (reverse pts) startp))))
    (if (= i (1- n)) (setq pts (gip:rt-snap-end pts sockp)) (setq pts (gip:rt-simplify pts)))
    (if (> (length pts) 1) (setq res (cons (cons (car rn) pts) res)))
    (setq i (1+ i)))
  (reverse res))
;; polys — контуры помещений (списки точек), socks — розетки, shield — щит; всё в координатах чертежа.
;; Результат: список (ширина . точки). Число подключённых помещений / пропущенных розеток — в *gip:rt-info* (подкл. без-контура не-достигнуто)
(defun gip:rt-build (polys socks shield / an lp ls bbs bb xmin ymin xmax ymax g nx ny ix iy r k i sr rooms todo t1 srcs cells hit tc segs
                     cl res nR miss sh0 lost pk sp)
  (setq *gip:rt-info* nil an (gip:rt-angle polys))
  (setq lp (mapcar '(lambda (pl) (mapcar '(lambda (p) (gip:rt-to-loc p shield an)) pl)) polys)
        ls (mapcar '(lambda (p) (gip:rt-to-loc p shield an)) socks)
        bbs (mapcar 'gip:rt-bbox lp))
  (setq xmin 0.0 ymin 0.0 xmax 0.0 ymax 0.0)
  (foreach bb bbs
    (setq xmin (min xmin (car bb)) ymin (min ymin (cadr bb)) xmax (max xmax (caddr bb)) ymax (max ymax (cadddr bb))))
  (setq g *gip:rt-step*)
  (while (> (* (+ 3 (fix (/ (- xmax xmin) g))) (+ 3 (fix (/ (- ymax ymin) g)))) 14000) (setq g (+ g 50.0)))
  (setq nx (+ 3 (fix (/ (- xmax xmin) g))) ny (+ 3 (fix (/ (- ymax ymin) g)))
        *gip:rt-g* g *gip:rt-x0* (- xmin g) *gip:rt-y0* (- ymin g) *gip:rt-nx* nx *gip:rt-ny* ny)
  (setq ix 0)
  (while (< ix nx)
    (setq iy 0)
    (while (< iy ny)
      (setq r (gip:rt-classify lp bbs (gip:rt-cx ix) (gip:rt-cy iy) (* 0.75 g)))
      (if (> r 0)
        (progn (gip:rt-s "GRT_R" (gip:rt-ci ix iy) r)
               (if (< (car (gip:rt-near (gip:rt-cx ix) (gip:rt-cy iy) (nth (1- r) lp))) 350.0) (gip:rt-s "GRT_W" (gip:rt-ci ix iy) 1))))
      (setq iy (1+ iy)))
    (setq ix (1+ ix)))
  ;; розетка -> помещение (контур, в котором лежит; иначе ближайшая стена в пределах 150 мм)
  (setq todo nil miss 0)
  (foreach p ls
    (setq i 0 sr nil)
    (foreach pl lp
      (setq k (car (gip:rt-near (car p) (cadr p) pl)) pk (gip:rt-pip (car p) (cadr p) pl))
      (if (or pk (< k 150.0))
        (if (or (null sr) (and pk (not (nth 2 sr))) (and (equal (not pk) (not (nth 2 sr))) (< k (car sr))))
          (setq sr (list k i pk))))
      (setq i (1+ i)))
    (if sr
      (progn (setq t1 (assoc (nth 1 sr) todo))
             (if t1 (setq todo (subst (append t1 (list p)) t1 todo))
                    (setq todo (append todo (list (list (nth 1 sr) p))))))
      (setq miss (1+ miss))))
  (setq sh0 (gip:rt-goal-cell '(0.0 0.0) 0) segs nil res nil lost 0)
  (if (and sh0 todo)
    (progn
      (setq srcs (list sh0))
      (gip:rt-s "GRT_N" sh0 1)
      (foreach tr todo
        (setq k 0)
        (foreach p (cdr tr)
          (if (setq cl (gip:rt-goal-cell p (1+ (car tr)))) (gip:rt-s "GRT_T" cl (list (car tr) k)))
          (setq k (1+ k))))
      (setq nR (length todo))
      (while (and (> nR 0) (setq hit (gip:rt-dij srcs)))
        (setq cells (gip:rt-path-cells hit) tc (gip:rt-g "GRT_T" (last cells)))
        (foreach tr todo
          (if (= (car tr) (car tc))
            (foreach p (cdr tr)
              (if (setq cl (gip:rt-goal-cell p (1+ (car tr)))) (set (gip:rt-sym "GRT_T" cl) nil)))))
        (setq i 1)
        (while (< i (length cells))
          (if (null (gip:rt-g "GRT_N" (nth i cells)))
            (progn (gip:rt-s "GRT_N" (nth i cells) 1) (gip:rt-s "GRT_PAR" (nth i cells) (nth (1- i) cells))
                   (setq srcs (cons (nth i cells) srcs))))
          (setq i (1+ i)))
        (setq segs (append segs (list (list (car tc) (cadr tc) cells))) nR (1- nR))
        (gip:rt-free-d))
      (setq lost (apply '+ (mapcar '(lambda (tr) (length (cdr tr))) (vl-remove-if '(lambda (tr) (assoc (car tr) segs)) todo))))
      (foreach sg segs
        (setq cl (last (nth 2 sg)))
        (while cl
          (gip:rt-s "GRT_U" cl (1+ (if (gip:rt-g "GRT_U" cl) (gip:rt-g "GRT_U" cl) 0)))
          (setq cl (gip:rt-g "GRT_PAR" cl))))
      (foreach sg segs
        (setq sp (nth (nth 1 sg) (cdr (assoc (car sg) todo))))
        (setq res (append res (gip:rt-seg-lines (nth 2 sg) (if (= (car (nth 2 sg)) sh0) '(0.0 0.0)) sp)))
        (if (> (length (cdr (assoc (car sg) todo))) 1)
          (setq res (append res (list (cons 10 (gip:rt-chain (nth (car sg) lp) (cdr (assoc (car sg) todo)) (nth 1 sg)))))))))
    (setq lost (apply '+ (mapcar '(lambda (tr) (length (cdr tr))) todo))))
  (gip:rt-free)
  (setq *gip:rt-info* (list (length segs) miss lost))
  (mapcar '(lambda (l) (cons (car l) (mapcar '(lambda (p) (gip:rt-to-glob p shield an)) (cdr l)))) res))

;; ---------------------------------------------------------------- чертёж: сбор данных, рисование
(defun gip:rt-box (sh) (list (- (car (gip:g sh "F")) *gip:SW*) (cadr (gip:g sh "F")) (car (gip:g sh "F")) (+ (cadr (gip:g sh "F")) *gip:SHH*)))
(defun gip:rt-in (p b) (and (< (car b) (car p) (caddr b)) (< (cadr b) (cadr p) (cadddr b))))
;; точки вставки блоков заданного имени внутри рамки листа
(defun gip:rt-blocks (box blk / ss i e r nm)
  (setq r nil)
  (if (setq ss (ssget "_X" '((0 . "INSERT"))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i) i (1+ i))
        (if (and (not (assoc -3 (entget e (list *gip:app*)))) (gip:rt-in (cdr (assoc 10 (entget e))) box))
          (progn
            (setq nm (vl-catch-all-apply 'vlax-get (list (vlax-ename->vla-object e) 'EffectiveName)))
            (if (and (= (type nm) 'STR) (= nm blk))
              (setq r (cons (list (cadr (assoc 10 (entget e))) (caddr (assoc 10 (entget e)))) r))))))))
  (reverse r))
;; замкнутые полилинии слоя контуров помещений внутри рамки листа
(defun gip:rt-contours (box / ss i e r pts)
  (setq r nil)
  (if (setq ss (ssget "_X" (list '(0 . "LWPOLYLINE") (cons 8 (gip:layer "GIP_ПОМ_КОНТУР")))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i) i (1+ i) pts (gip:rm-pline-pts e))
        (if (and (> (length pts) 2) (gip:rt-in (car pts) box)) (setq r (cons pts r))))))
  (reverse r))
(defun gip:rt-erase (box lay / ss i e)
  (if (setq ss (ssget "_X" (list '(0 . "LWPOLYLINE") (cons 8 lay))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i) i (1+ i))
        (if (gip:rt-in (car (gip:rm-pline-pts e)) box) (entdel e))))))
(defun gip:rt-draw (res lay col / n)
  (gip:layer lay)
  (setq n 0)
  (foreach l res
    (entmake (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) (cons 62 col) '(100 . "AcDbPolyline")
                           (cons 90 (length (cdr l))) '(70 . 0) (cons 43 (float (car l))))
                     (mapcar '(lambda (p) (list 10 (car p) (cadr p))) (cdr l))))
    (setq n (1+ n)))
  n)
;; силовые: розетки листа -> трассы от щита (точка shield в координатах чертежа)
(defun gip:routes-power (sh shield / box polys socks res n)
  (setq box (gip:rt-box sh) polys (gip:rt-contours box) socks (gip:rt-blocks box "ЭОМ_Розетки_GIP"))
  (cond
    ((null polys) (princ "\nГИП: на листе нет контуров помещений (панель «Помещения» → контуры). Трассы не построены.") nil)
    ((null socks) (princ "\nГИП: на листе нет розеток ЭОМ_Розетки_GIP.") nil)
    (T
     (gip:rt-erase box *gip:rt-lay-p*)
     (setq res (gip:rt-build polys socks shield))
     (setq n (gip:rt-draw res *gip:rt-lay-p* 1))
     (princ (strcat "\nГИП: силовые трассы: линий " (itoa n) ", помещений подключено " (itoa (car *gip:rt-info*))
                    (if (> (nth 2 *gip:rt-info*) 0) (strcat ", НЕ достигнуто розеток: " (itoa (nth 2 *gip:rt-info*))) "")
                    (if (> (nth 1 *gip:rt-info*) 0) (strcat ", розеток вне контуров: " (itoa (nth 1 *gip:rt-info*))) "") "."))
     n)))
(defun c:GIPTRASSY (/ p sh)
  (setq p (getpoint "\nУкажите положение электрощита на плане: "))
  (if p
    (progn
      (setq sh (vl-some '(lambda (s) (if (and (gip:starts (gip:g s "role") "plan_") (gip:rt-in p (gip:rt-box s))) s)) (gip:template-sheets)))
      (cond ((null sh) (princ "\nГИП: точка вне листа плана."))
            ((= (gip:g sh "role") "plan_p") (gip:routes-power sh (list (car p) (cadr p))))
            (T (princ "\nГИП: для этого листа трассы пока не поддерживаются.")))))
  (princ))
