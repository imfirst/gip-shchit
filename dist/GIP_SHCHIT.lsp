                                                    (cons "o" (list (cons "ser" (if is3 "VIP-63 x3" "VIP-63")) '("maker" . "Welrok")
                                                                    (cons "ref" (gip:join (mapcar '(lambda (r) (gip:g r "ref")) rns) ", ")))))))))
      (if fire (setq chain (append chain (list (list (cons "p" (if is3 "dev_d3" "dev_d1")) (cons "rel" nil) (cons "d" fire)
                                                     (cons "o" (list '("ma" . "100") (cons "ser" (gip:rcd-ser (gip:g b (if is3 "fire4" "fire2")))) $Q144 (cons "vis" (gip:rcd-vis is3)))))))))
      (setq y0 (if (> (length chain) 2) 787.0 169.0) xi 3973.06 kk 0)
      (foreach cn chain
        (setq yy (- y0 (* kk 618.0)))
        (if (gip:g cn "rel")
          (setq px OX py (+ OY (if (= (gip:g cn "p") "in3") (- yy 168.7) (+ yy 449.4))))
          (setq px (+ OX xi) py (+ OY yy)))
        (setq rr cn)
        (gip:place (gip:g cn "p") px py '(lambda (its) (gip:dev-atts its (gip:g rr "d") (gip:g rr "o"))))
        (setq kk (1+ kk)))
      (setq yb (- y0 (* (length chain) 618.0)))
      (if (gip:g S "floorShield")
        (progn
          (gip:place "ln_Ltop" 0.0 0.0 '(lambda (its) (list (gip:it-line (car its) (+ OX xi) (+ OY y0) (+ OX xi) (+ OY 939.0)))))
