;; провод со скруглёнными углами (дуги-сопряжения через bulge)
(defun gip:mwire (pts net / out bul i p0 p1 p2 l1 l2 r a b d1x d1y d2x d2y cr dt th)
  (setq out (list (car pts)) bul (list 0.0) i 1)
  (while (< i (1- (length pts)))
    (setq p0 (nth (1- i) pts) p1 (nth i pts) p2 (nth (1+ i) pts))
    (setq l1 (distance p0 p1) l2 (distance p1 p2))
    (setq r (min *gip:RC* (/ l1 2.0) (/ l2 2.0)))
    (if (< r 0.5)
      (setq out (append out (list p1)) bul (append bul (list 0.0)))
      (progn
        (setq a (list (+ (car p1) (/ (* (- (car p0) (car p1)) r) l1)) (+ (cadr p1) (/ (* (- (cadr p0) (cadr p1)) r) l1))))
        (setq b (list (+ (car p1) (/ (* (- (car p2) (car p1)) r) l2)) (+ (cadr p1) (/ (* (- (cadr p2) (cadr p1)) r) l2))))
        ;; направление в координатах модели (ось Y вверх): y_модели = -y_pt
        (setq d1x (- (car p1) (car p0)) d1y (- (- (cadr p1) (cadr p0))) d2x (- (car p2) (car p1)) d2y (- (- (cadr p2) (cadr p1))))
        (setq cr (- (* d1x d2y) (* d1y d2x)) dt (+ (* d1x d2x) (* d1y d2y)))
        (setq th (atan (abs cr) dt))
        (setq out (append out (list a b)) bul (append bul (list (* (if (minusp cr) -1.0 1.0) (/ (sin (/ th 4)) (cos (/ th 4)))) 0.0)))))
    (setq i (1+ i)))
  (setq out (append out (list (last pts))) bul (append bul (list 0.0)))
  ;; bulge относится к вершине, с которой начинается дуга
  (gip:mpoly out nil (cdr (assoc net *gip:netc*)) 3.6 (gip:bul-shift bul)))
(defun gip:bul-shift (bul / r i)
  ;; bul: 0 у начала, для каждого скругления — (bulge 0) у точек a b; дуга идёт от a к b => bulge ставим на a
  (setq r nil i 0)
  (foreach v bul (setq r (append r (list v))))
  r)
(defun gip:ferr (x y net up / tc)
  (setq tc (cdr (assoc net *gip:netc*)))
  (gip:mrect (- x 4) (if up (- y 15) (+ y 3)) 8.0 12.0 tc 2236962))

;; бирка: жёлтый прямоугольник с текстом
(defun gip:split-text (s mx ml / words out cur)
  (setq out nil cur "")
  (foreach w (gip:split s " ")
    (if (<= (strlen (gip:trim (strcat cur " " w))) mx)
      (setq cur (gip:trim (strcat cur " " w)))
      (progn (if (/= cur "") (setq out (append out (list cur))))
             (while (> (strlen w) mx) (setq out (append out (list (strcat (substr w 1 (1- mx)) "-"))) w (substr w mx)))
             (setq cur w))))
  (if (/= cur "") (setq out (append out (list cur))))
  (if (> (length out) ml) (setq out (append (gip:take out (1- ml)) (list (strcat (substr (nth (1- ml) out) 1 (max 1 (1- mx))) $S164)))))
  out)
(defun gip:tagbox (x y txt w / lines h i)
  (setq lines (gip:split-text txt (fix (/ (- w 6) 5.6)) 2) h (+ 4 (* (length lines) 11)))
  (gip:mrect x y w h 16776960 8026624)
  (setq i 0)
  (foreach ln lines (gip:mtext (+ x (/ w 2.0)) (+ y 11 (* i 11)) 9.6 ln 1118481 1) (setq i (1+ i))))
(defun gip:loadtag (x y w h d / name per lines i)
  (setq name (gip:g d "name"))
  (if (gip:starts name $S65) (setq name (strcat $S165 (substr name 12))))
  (setq per (max 5 (fix (/ (- w 4) 4.6))) lines (gip:split-text name per 4))
  (gip:mrect x y w (+ 10 (* (length lines) 9.5)) 16776960 8026624)
  (gip:mtext (+ x (/ w 2.0)) (+ y 9) 8.4 (gip:gn d "ref" "") 1194109 1)
  (setq i 0)
  (foreach ln lines (gip:mtext (+ x (/ w 2.0)) (+ y 18.5 (* i 9.5)) 8.2 ln 1118481 1) (setq i (1+ i))))
(defun gip:facetag (x y w d / n ww)
  (setq n (cond ((= (gip:g d "id") "c2") $S166)
                ((= (gip:g d "kind") "in") $S167) ((= (gip:g d "kind") "rn") $S168)
                ((= (gip:g d "kind") "fire") $S169) ((= (gip:g d "kind") "km") $S170)
                ((= (gip:g d "kind") "rcd") (strcat $S171 (itoa (gip:gn d "rcdNo" 0)))) (T nil)))
  (cond ((= (gip:g d "kind") "xb") (gip:tagbox (+ x 4) (+ y (* (gip:g d "h") 0.32)) (strcat (gip:gn d "ref" "") $S172) (- w 8)))
        (n (setq ww (max (- w 4) 44.0)) (gip:tagbox (+ x (/ (- w ww) 2.0)) y (strcat (gip:gn d "ref" "") " " n) ww))))
(defun gip:busshape (x y n col dark / w i cx)
  (setq w (+ (* n 13) 22))
  (gip:mpoly (list (list (+ x 4) (+ y 14)) (list (+ x 10) (- y 2)) (list (- (+ x w) 10) (- y 2)) (list (- (+ x w) 4) (+ y 14))) T 9079434 0.0 nil)
  (gip:mrect x (+ y 14) w 9.0 col dark)
  (setq i 0)
