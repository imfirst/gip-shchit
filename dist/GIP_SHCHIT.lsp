(defun gip:line (id name cat prot poles In p / l)
  (list (cons "id" id) (cons "name" name) (cons "cat" cat) (cons "prot" prot) (cons "poles" poles) (cons "In" In) (cons "p" p)))

(defun gip:build-lines (s / LNS is3 app i n f a lst edit o light1 split3 rest k)
  (setq LNS nil is3 (= (gip:g s "phases") 3) app (gip:g s "app") edit (gip:g s "edit"))
  (setq i 0)
  (foreach n (gip:g s "light")
    (setq LNS (cons (gip:s (gip:line (strcat "light" (itoa i) ":" n) (strcat $S65 n) "light" "a" 1 10 0.3) "km" T) LNS) i (1+ i)))
  (if (gip:g app "hob")
    (setq LNS (cons (if is3 (gip:line "hob" $S66 "hob" "a" 3 16 7.5) (gip:line "hob" $S66 "hob" "a" 1 32 7.0)) LNS)))
  (if (gip:g app "oven") (setq LNS (cons (gip:line "oven" $S67 "app" "d" 1 16 3.5) LNS)))
  (if (gip:g app "fridge") (setq LNS (cons (gip:line "fridge" $S68 "app" "d" 1 16 0.5) LNS)))
  (if (gip:g app "dw") (setq LNS (cons (gip:line "dw" $S69 "app" "d" 1 16 2.2) LNS)))
  (if (gip:g app "wash") (setq LNS (cons (gip:line "wash" $S70 "app" "d" 1 16 2.3) LNS)))
  (if (gip:g app "dry") (setq LNS (cons (gip:line "dry" $S71 "app" "d" 1 16 2.5) LNS)))
  (setq i 0)
  (foreach n (gip:g s "sockets")
    (setq LNS (cons (gip:line (strcat "sock" (itoa i) ":" n) n "sock" "d" 1 16 1.5) LNS) i (1+ i)))
  (setq f 1)
  (while (<= f (gip:gn s "floor" 0))
    (setq LNS (cons (gip:line (strcat "floor" (itoa f)) (strcat $S72 (if (> (gip:g s "floor") 1) (strcat " " (itoa f)) "")) "floor" "d" 1 16 1.2) LNS) f (1+ f)))
  (cond ((= (gip:g s "heater") "boiler") (setq LNS (cons (gip:line "heater" $S73 "heat" "d" 1 16 2.0) LNS)))
        ((= (gip:g s "heater") "flow")
         (setq LNS (cons (if is3 (gip:line "heater" $S74 "heat" "d3" 3 16 9.0) (gip:line "heater" $S74 "heat" "d" 1 32 6.0)) LNS))))
  (if (gip:g app "leak") (setq LNS (cons (gip:line "leak" $S75 "leak" "d" 1 16 0.2) LNS)))
  (setq a 1)
  (while (<= a (gip:gn s "ac" 0))
    (setq LNS (cons (gip:line (strcat "ac" (itoa a)) (strcat $S76 (if (> (gip:g s "ac") 1) (strcat " " (itoa a)) "")) "ac" "a" 1 16 1.2) LNS) a (1+ a)))
  (foreach c (gip:g s "custom")
    (setq LNS (cons (gip:s (gip:line (gip:g c "id") (gip:g c "name") "custom" (gip:g c "prot") (gip:g c "poles") (gip:g c "In") (gip:g c "p")) "custom" T) LNS)))
  (setq LNS (reverse LNS))
  ;; правки пользователя
  (setq LNS (vl-remove-if '(lambda (l) (member (gip:g l "id") (gip:g s "removed"))) LNS))
  (setq LNS (mapcar $Q77 LNS))
  ;; фазы
  (if is3
    (progn
      (setq LNS (mapcar '(lambda (l) (if (= (gip:g l "poles") 3) (gip:s l "phase" "L123") l)) LNS))
      ;; освещение: по трём фазам по порядку
      (setq light1 (vl-remove-if-not '(lambda (l) (and (= (gip:g l "cat") "light") (= (gip:g l "poles") 1))) LNS))
      (setq n (length light1) k 0)
      (setq LNS (mapcar '(lambda (l / idx)
                         (if (setq idx (gip:index l light1))
                           (gip:s l "phase" (nth (min 2 (fix (/ (* idx 3.0) (max n 1)))) '("L1" "L2" "L3")))
                           l)) LNS))
      ;; остальные однофазные — тремя сплошными участками с ровной мощностью
      (setq rest (vl-remove-if-not '(lambda (l) (and (= (gip:g l "poles") 1) (/= (gip:g l "cat") "light"))) LNS))
      (setq LNS (gip:split3 LNS rest))
      (setq LNS (mapcar '(lambda (l / o) (setq o (gip:g edit (gip:g l "id")))
                         (if (and (gip:g o "phase") (= (gip:g l "poles") 1)) (gip:s l "phase" (gip:g o "phase")) l)) LNS)))
    (setq LNS (mapcar '(lambda (l) (gip:s l "phase" (if (= (gip:g l "poles") 3) "L123" "L"))) LNS)))
  LNS)

;; деление последовательности на три участка L1/L2/L3 (как split3 в конструкторе)
(defun gip:split3 (LNS arr / n pre i j a1 a2 a3 m cnt best k ids res)
  (setq n (length arr))
  (if (= n 0)
    LNS
    (progn
      (setq pre (list 0.0))
      (foreach l arr (setq pre (append pre (list (+ (last pre) (gip:g l "p"))))))
      (setq best nil i 0)
      (while (<= i n)
        (setq j i)
        (while (<= j n)
          (setq a1 (nth i pre) a2 (- (nth j pre) (nth i pre)) a3 (- (nth n pre) (nth j pre)))
          (setq m (max a1 a2 a3))
          (setq cnt (- (max i (- j i) (- n j)) (min i (- j i) (- n j))))
          (if (or (null best) (< m (- (car best) 1e-9)) (and (< (abs (- m (car best))) 1e-9) (< cnt (cadr best))))
            (setq best (list m cnt i j)))
          (setq j (1+ j)))
        (setq i (1+ i)))
      (setq ids (mapcar '(lambda (l) (gip:g l "id")) arr))
      (mapcar '(lambda (l / k)
                 (if (setq k (gip:index (gip:g l "id") ids))
                   (gip:s l "phase" (cond ((< k (nth 2 best)) "L1") ((< k (nth 3 best)) "L2") (T "L3")))
                   l)) LNS))))

(defun gip:std-up (v lst / r)
  (setq r nil)
  (foreach x lst (if (and (null r) (>= x v)) (setq r x)))
  (if r r (last lst)))

(defun gip:dev (pairs) pairs)

;; общие аппараты щита: ввод, реле, УЗО 100 мА, кросс-модуль, КМ (используют переменные вызывающей функции: b is3 useKm)
(defun gip:fixed-devs (s lines / D inPoles inP fi hasLight bn kt)
  (setq D nil)
  (setq inPoles (if is3 (if (= (gip:g s "inPoles") 4) 4 3) 2))
  (setq inP (if is3 (if (= inPoles 4) '("L1" "L2" "L3" "N") '("L1" "L2" "L3")) '("L" "N")))
  (setq bn (gip:g b "name"))
  (setq D (cons (list '("id" . "in") '("kind" . "in") (cons "w" inPoles) (cons "poles" inP) (cons "bot" inP) (cons "In" (gip:g s "inA"))
                      (cons "model" (gip:fmt-model (if is3 (if (= inPoles 4) (gip:g b "a4") (gip:g b "a3")) (gip:g b "a2")) (gip:g s "inA")))
                      $Q78 (cons "brand" bn) '("feed" . "ext")) D))
  (if (gip:g s "relay")
    (if is3
      (foreach p '("L1" "L2" "L3")
        (setq D (cons (list (cons "id" (strcat "rn" (substr p 2 1))) '("kind" . "rn") '("w" . 2) '("poles") '("bot" "L" "N" "Lo") (cons "phase" p) '("In" . 63)
                            $Q79 (cons "name" (strcat $S80 p)) '("brand" . "Welrok") '("feed" . "in")) D)))
      (setq D (cons (list '("id" . "rn1") '("kind" . "rn") '("w" . 2) '("poles") '("bot" "L" "N" "Lo") '("phase" . "L") '("In" . 63)
                          $Q79 $Q81 '("brand" . "Welrok") '("feed" . "in")) D))))
  (if (gip:g s "fire")
    (progn
      (setq fi (gip:std-up (max (gip:g s "inA") 40) '(40 63 80 100)))
      (setq D (cons (list '("id" . "fire") '("kind" . "fire") (cons "w" (if is3 4 2))
                          (cons "poles" (if is3 '("L1" "L2" "L3" "N") '("L" "N"))) (cons "bot" (if is3 '("L1" "L2" "L3" "N") '("L" "N")))
                          (cons "In" fi) (cons "model" (gip:fmt-model (if is3 (gip:g b "fire4") (gip:g b "fire2")) fi))
                          $Q82 (cons "brand" bn) '("feed" . "up")) D))))
  (if (gip:g s "xb")
    (setq D (cons (list '("id" . "xb") '("kind" . "xb") (cons "w" (if is3 5 3))
                        (cons "poles" (if is3 '("L1" "L2" "L3" "N") '("L" "N"))) (cons "bot" (if is3 '("L1" "L2" "L3" "N") '("L" "N")))
                        (cons "model" (if is3 $S83 $S84)) $Q85 $Q86 '("feed" . "up")) D)))
  (if useKm
    (progn
      (setq D (cons (list '("id" . "c2") '("kind" . "a1") '("w" . 1) '("poles" "L") '("bot" "L") (cons "phase" (if is3 "L1" "L")) '("In" . 2)
                          (cons "model" (gip:fmt-model (gip:g b "a1") 2)) $Q87 (cons "brand" bn) '("feed" . "src")) D))
      (setq kt (gip:km-of s))
      (setq D (cons (list '("id" . "km") '("kind" . "km") (cons "w" (nth 3 kt)) (cons "kmType" (car kt)) (cons "kmI" (cadr kt)) (cons "kmC" (caddr kt))
                          (cons "poles" (if is3 '("A1" "L1" "L2" "L3") '("A1" "L"))) (cons "bot" (if is3 '("A2" "L1" "L2" "L3") '("A2" "L")))
                          (cons "model" (gip:km-model s kt)) $Q88 (cons "brand" bn) '("feed" . "src")) D))))
  (reverse D))

;; аппараты щита (режим шаблона)
(defun gip:build-devices (s lines / b is3 D hasLight useKm rcdN ri run)
  (setq b (gip:brand (gip:g s "brand")) is3 (= (gip:g s "phases") 3))
  (setq hasLight (vl-some '(lambda (l) (gip:g l "km")) lines))
  (setq useKm (and (gip:g s "km") hasLight))
  (setq D (reverse (gip:fixed-devs s lines)))
  (setq rcdN 0 ri (max 40 (gip:std-up (gip:g s "inA") '(25 40 63 80))) run nil)
  (foreach l lines
    (cond
      ((gip:g l "km")
       (gip:flush-run) (setq D (cons (gip:line-dev l (if useKm "km" "src")) D)))
      ((and (= (gip:g s "prot") "rcd") (= (gip:g l "prot") "d") (= (gip:g l "poles") 1))
       (if (and run (/= (gip:g (car run) "phase") (gip:g l "phase"))) (gip:flush-run))
       (setq run (append run (list l))))
      (T (gip:flush-run) (setq D (cons (gip:line-dev l "src") D)))))
  (gip:flush-run)
  (reverse D))

;; вспомогательные функции build-devices (используют переменные вызывающей функции: D run rcdN ri b s)
(defun gip:line-dev (l feed / d)
  (setq d (list (cons "id" (strcat "L:" (gip:g l "id"))) (cons "line" l) (cons "name" (gip:g l "name")) (cons "In" (gip:g l "In"))
                (cons "phase" (gip:g l "phase")) (cons "feed" feed) (cons "brand" (gip:g b "name"))))
  (cond
    ((= (gip:g l "poles") 3)
     (if (= (gip:g l "prot") "d3")
       (setq d (append d (list '("kind" . "dif4") '("w" . 4) '("poles" "L1" "L2" "L3" "N") '("bot" "L1" "L2" "L3" "N")
                               (cons "model" (gip:fmt-model (gip:g b "dif4") (gip:g l "In"))))))
       (setq d (append d (list '("kind" . "a3") '("w" . 3) '("poles" "L1" "L2" "L3") '("bot" "L1" "L2" "L3")
                               (cons "model" (gip:fmt-model (gip:g b "a3") (gip:g l "In"))))))))
    ((and (= (gip:g l "prot") "d") (= (gip:g s "prot") "dif"))
     (setq d (append d (list '("kind" . "dif") '("w" . 2) '("poles" "L" "N") '("bot" "L" "N") (cons "model" (gip:fmt-model (gip:g b "dif") (gip:g l "In")))))))
    (T (setq d (append d (list '("kind" . "a1") '("w" . 1) '("poles" "L") '("bot" "L") (cons "model" (gip:fmt-model (gip:g b "a1") (gip:g l "In"))))))))
  d)

(defun gip:rcd-group (ls / rid ph)
  (setq rcdN (1+ rcdN) rid (strcat "rcd" (itoa rcdN) ":" (gip:g (car ls) "id")) ph (gip:g (car ls) "phase"))
  (setq D (cons (list (cons "id" rid) '("kind" . "rcd") '("w" . 2) '("poles" "L" "N") '("bot" "L" "N") (cons "phase" ph) (cons "In" ri)
                      (cons "model" (gip:fmt-model (gip:g b "rcd2") ri)) (cons "name" (strcat $S89 (itoa rcdN)))
                      (cons "brand" (gip:g b "name")) '("feed" . "src") (cons "rcdNo" rcdN)) D))
  (foreach l ls (setq D (cons (gip:s (gip:line-dev l rid) "rcdNo" rcdN) D))))

(defun gip:flush-run (/ g sz k)
  (if run
    (progn
      (setq g (gip:ceil (/ (length run) 4.0)) sz (gip:ceil (/ (length run) (float g))) k 0)
      (while (< k (length run))
        (gip:rcd-group (gip:take (gip:drop run k) sz))
        (setq k (+ k sz)))
      (setq run nil))))

;; порядок с учётом перетаскиваний: order — id по порядку, новые — после ближайшего предшественника
(defun gip:apply-order (s DEVS / order out used pos k idx byid j)
  (setq order (gip:g s "order"))
  (if (null order)
    DEVS
    (progn
      (setq out nil used nil)
      (foreach id order
        (foreach d DEVS (if (and (= (gip:g d "id") id) (not (member id used))) (setq out (append out (list d)) used (cons id used)))))
      (setq k 0)
      (foreach d DEVS
        (if (not (member (gip:g d "id") used))
          (progn
            (setq pos 0 idx (1- k))
            (while (>= idx 0)
              (if (and (= pos 0) (setq j (gip:index (nth idx DEVS) out))) (setq pos (1+ j) idx -1))
              (setq idx (1- idx)))
            (setq out (append (gip:take out pos) (list d) (gip:drop out pos)) used (cons (gip:g d "id") used))))
        (setq k (1+ k)))
      out)))

;; раскладка по рейкам
(defun gip:flow-rails (s DEVS / W rails cur used total need i d brk gw j nxt bx)
  (setq W (gip:g s "railW") rails nil cur nil used 0 i 0)
  (foreach d DEVS
    (setq brk (and (or (member (gip:g d "id") (gip:g s "breaks")) (member i (gip:g s "breakAt"))) cur))
    (setq gw (gip:g d "w"))
    (if (and (null (gip:g s "order")) (or (= (gip:g d "kind") "rcd") (= (gip:g d "id") "c2")))
      (progn
        (setq j (1+ i))
        (while (and (< j (length DEVS))
                    (progn (setq nxt (nth j DEVS))
                           (or (= (gip:g nxt "feed") (gip:g d "id"))
                               (and (= (gip:g d "id") "c2") (or (= (gip:g nxt "id") "km") (= (gip:g nxt "feed") "km"))))))
          (setq gw (+ gw (gip:g nxt "w")) j (1+ j)))
        (if (> gw W) (setq gw (gip:g d "w")))))
    (if (or brk (> (+ used gw) W)) (setq rails (append rails (list cur)) cur nil used 0))
    (setq cur (append cur (list d)) used (+ used (gip:g d "w")) i (1+ i)))
  (if cur (setq rails (append rails (list cur))))
  (setq total (gip:sum (mapcar '(lambda (d) (gip:g d "w")) DEVS)))
  (setq need (max (length rails) (gip:ceil (/ (* total 1.2) W))))
  (if (> (gip:gn s "railsMin" 0) 0) (setq need (max need (gip:g s "railsMin"))))
  ;; настоящий корпус ABB: реек на схеме столько же, сколько рядов в корпусе
  (if (setq bx (gip:pick-box W total (max need (length rails)))) (setq need (max need (cadr bx))))
  (while (< (length rails) need) (setq rails (append rails (list nil))))
  (list (cons "rails" rails) (cons "used" total) (cons "cap" (* (length rails) W)) (cons "box" bx)))

;; обозначения QF, QFD, QD, KV, KM, XT по порядку на рейках
(defun gip:designate (rails / c p r)
  (setq c '(("QF" . 0) ("QFD" . 0) ("QD" . 0) ("KV" . 0) ("KM" . 0) ("XT" . 0)))
  (mapcar '(lambda (r)
             (mapcar '(lambda (d / k p n)
                        (setq k (gip:g d "kind"))
                        (setq p (cond ((member k '("dif" "dif4")) "QFD") ((member k '("rcd" "fire")) "QD") ((= k "rn") "KV")
                                      ((= k "km") "KM") ((= k "xb") "XT") (T "QF")))
                        (setq n (1+ (gip:g c p)) c (gip:s c p n))
                        (gip:s d "ref" (strcat p (itoa n)))) r)) rails))

(defun gip:cos (l) (if (or (member (gip:g l "cat") '("hob" "heat" "floor")) (= (gip:gn l "key" (gip:g l "id")) "oven")) 1.0 0.9))

;; ориентировочная длина кабеля линии по площади квартиры, м
(defun gip:cable-len (l area / s cat k c)
  (setq s (sqrt (max area 15.0)) cat (gip:g l "cat"))
  ;; калибровка по проекту «Сосновая»: свет ~50 м на линию (шлейф по светильникам), розетки ~16 м, техника ~11 м
  (cond ((= cat "light") (setq k 4.0 c 10.0))
        ((= cat "sock") (setq k 1.2 c 4.0))
        ((member cat '("hob" "app" "floor" "heat" "leak")) (setq k 0.9 c 2.0))
        ((= cat "ac") (setq k 1.2 c 4.0))
        (T (setq k 1.2 c 4.0)))
  (gip:ceil (* (+ c (* k s)) 1.1)))

;; полный расчёт щита
(defun gip:board (s / lines devs flow rails all area v2)
  (setq v2 (= (gip:g s "v") 2))
  (setq lines (if v2 (gip:rows-lines s) (gip:build-lines s)) area (gip:gn s "area" 50.0))
  (setq lines (mapcar '(lambda (l) (if (gip:g l "len") l (gip:s l "len" (gip:cable-len l area)))) lines))
  (setq devs (if v2 (gip:rows-order s (gip:rows-devices s lines)) (gip:apply-order s (gip:build-devices s lines))))
  (setq flow (gip:flow-rails s devs))
  (setq rails (gip:designate (gip:g flow "rails")))
  (setq all (apply 'append rails))
  (list (cons "lines" lines) (cons "devs" devs) (cons "rails" rails) (cons "all" all) (cons "cap" (gip:g flow "cap")) (cons "used" (gip:g flow "used")) (cons "box" (gip:g flow "box"))))
;;; ============================================================================
;;; Состав щита из таблицы групп (панель AutoCAD): строки групп ("t" "g") и УЗО ("t" "u") по порядку
;;; слева направо. Группы под УЗО (защита "rcd") идут сразу за своим УЗО.
;;; Хранение: словарь чертежа GIPPANEL — JSON таблицы (только ASCII, русский как \uXXXX).
;;; ============================================================================

(setq *gip:row-cat* '(("light" . "light") ("elight" . "light") ("sock" . "sock") ("hob" . "hob") ("oven" . "app") ("app" . "app")
                      ("floor" . "floor") ("heat" . "heat") ("ac" . "ac") ("leak" . "leak") ("other" . "custom") ("reserve" . "custom")))

(defun gip:row-ser (cat) (cond ((= cat "elight") $S90) ((member cat '("light")) $S91) (T $S92)))
(defun gip:sec-for (In) (cond ((<= In 10) "1,5") ((<= In 20) "2,5") ((<= In 25) "4") ((<= In 32) "6") ((<= In 50) "10") (T "16")))
(defun gip:row-cable (r light / p)
  (setq p (gip:nz (gip:g r "poles") 1))
  (cond ((gip:g r "cable"))
        ((and (= (gip:g r "cat") "hob") (= p 3)) $S93)
        (light (if (= p 3) $S59 $S60))
        (T (strcat (if (= p 3) "5" "3") $S94 (gip:sec-for (gip:nz (gip:g r "In") 16))))))
(defun gip:num-float (v d) (cond ((numberp v) (float v)) (T d)))

;; строки таблицы -> групповые линии (поля как у gip:build-lines)
(defun gip:rows-lines (s / is3 rows cur cnt res r rc cat ser n p light ph l lens)
  (setq is3 (= (gip:g s "phases") 3) rows (gip:g s "rows") cur nil res nil)
  (setq cnt (list (cons $S91 0) (cons $S90 0) (cons $S92 0)))
  (foreach r rows
    (if (= (gip:g r "t") "u")
      (setq cur r)
      (progn
        (if (/= (gip:g r "prot") "rcd") (setq cur nil))
        (setq rc (gip:g r "cat") cat (gip:gn *gip:row-cat* rc "custom") ser (gip:row-ser rc))
        (setq n (1+ (gip:g cnt ser)) cnt (gip:s cnt ser n))
        (setq p (gip:nz (gip:g r "poles") 1) light (= cat "light"))
        (if (and (not is3) (= p 3)) (setq p 1))
        (setq ph (cond ((not is3) (if (= p 3) "L123" "L"))
                       ((= p 3) "L123")
                       ((and cur (/= (gip:g cur "poles") 4) (member (gip:g cur "phase") '("L1" "L2" "L3"))) (gip:g cur "phase"))
                       ((member (gip:g r "phase") '("L1" "L2" "L3")) (gip:g r "phase"))
                       (T "L1")))
        (setq l (list (cons "id" (gip:g r "id")) (cons "name" (gip:gn r "name" $S95)) (cons "cat" cat) (cons "rcat" rc)
                      (cons "prot" (cond ((= (gip:g r "prot") "av") "a") ((and (= (gip:g r "prot") "dif") (= p 3)) "d3") (T "d")))
                      (cons "gprot" (gip:gn r "prot" "dif")) (cons "poles" p) (cons "In" (gip:nz (gip:g r "In") 16))
                      (cons "p" (if (= rc "reserve") 0.0 (gip:num-float (gip:g r "p") 0.0))) (cons "phase" ph)
                      (cons "cable" (if (= rc "reserve") "" (gip:row-cable r light)))
                      (cons "km" (and (gip:g s "km") (gip:g r "km") (/= (gip:g r "prot") "rcd")))
                      (cons "num" (strcat ser "-" (itoa n))) (cons "idn" (gip:nz (gip:g r "idn") 30))
                      (cons "rcd" (if (and cur (= (gip:g r "prot") "rcd")) (gip:g cur "id")))
                      (cons "key" (cond ((gip:g r "key")) ((= rc "oven") "oven") (T nil)))))
        (if (= rc "reserve") (setq l (append l (list (cons "reserve" T) (cons "len" 0)))))
        (if (and (/= rc "reserve") (numberp (gip:g r "len"))) (setq l (append l (list (cons "len" (gip:ceil (gip:g r "len")))))))
        (if (= rc "custom") (setq l (gip:s l "custom" T)))
        (setq res (cons l res)))))
  (reverse res))

;; модель аппарата с током утечки и типом УЗО
(defun gip:model-idn (m idn typ)
  (if (and idn (/= idn 30))
    (setq m (gip:repl (gip:repl (gip:repl m "/0,03" (strcat "/" (gip:repl (rtos (/ idn 1000.0) 2 (if (< idn 100) 2 1)) "." ","))) "A30" (strcat "A" (itoa idn))) $S96 (strcat (itoa idn) $S97))))
  (if (= typ "AC") (setq m (gip:repl m " A-" " AC-")))
  m)

;; строки таблицы -> аппараты щита в порядке строк
(defun gip:rows-devices (s lines / b is3 D useKm rcdN cur r l dv k w ps id rid lid)
  (setq b (gip:brand (gip:g s "brand")) is3 (= (gip:g s "phases") 3))
  (setq useKm (and (gip:g s "km") (vl-some '(lambda (l) (gip:g l "km")) lines)))
  (setq D (reverse (gip:fixed-devs s lines)) rcdN 0 cur nil)
  (foreach r (gip:g s "rows")
    (if (= (gip:g r "t") "u")
      (progn
        (setq rcdN (1+ rcdN) w (if (and is3 (= (gip:g r "poles") 4)) 4 2) rid (strcat "rcd:" (gip:g r "id")) cur rid)
        (setq ps (if (= w 4) '("L1" "L2" "L3" "N") '("L" "N")))
        (setq D (cons (list (cons "id" rid) '("kind" . "rcd") (cons "w" w) (cons "poles" ps) (cons "bot" ps)
                            (cons "phase" (cond ((= w 4) "L123") ((not is3) "L") ((member (gip:g r "phase") '("L1" "L2" "L3")) (gip:g r "phase")) (T "L1")))
                            (cons "In" (gip:nz (gip:g r "In") 40)) (cons "idn" (gip:nz (gip:g r "idn") 30)) (cons "type" (gip:gn r "type" "A"))
                            (cons "model" (gip:model-idn (gip:fmt-model (gip:g b (if (= w 4) "rcd4" "rcd2")) (gip:nz (gip:g r "In") 40)) (gip:nz (gip:g r "idn") 30) (gip:gn r "type" "A")))
                            (cons "name" (strcat $S89 (itoa rcdN))) (cons "brand" (gip:g b "name")) '("feed" . "src")
                            (cons "rcdNo" rcdN) (cons "row" (gip:g r "id"))) D)))
      (progn
        (setq lid (gip:g r "id") l (vl-some '(lambda (x) (if (= (gip:g x "id") lid) x)) lines))
        (if (/= (gip:g r "prot") "rcd") (setq cur nil))
        (setq dv (list (cons "id" (strcat "L:" lid)) (cons "line" l) (cons "name" (gip:g l "name")) (cons "In" (gip:g l "In"))
                      (cons "phase" (gip:g l "phase")) (cons "brand" (gip:g b "name")) (cons "row" lid) (cons "idn" (gip:g l "idn"))
                      (cons "feed" (cond ((and cur (= (gip:g r "prot") "rcd")) cur) ((and useKm (gip:g l "km")) "km") (T "src")))))
        (if (and cur (= (gip:g r "prot") "rcd")) (setq dv (append dv (list (cons "rcdNo" rcdN)))))
        (setq k (if (= (gip:g r "prot") "dif") (if (= (gip:g l "poles") 3) "dif4" "dif") (if (= (gip:g l "poles") 3) "a3" "a1")))
        (setq dv (append dv (cond ((= k "dif4") (list '("kind" . "dif4") '("w" . 4) '("poles" "L1" "L2" "L3" "N") '("bot" "L1" "L2" "L3" "N")))
                                ((= k "dif") (list '("kind" . "dif") '("w" . 2) '("poles" "L" "N") '("bot" "L" "N")))
                                ((= k "a3") (list '("kind" . "a3") '("w" . 3) '("poles" "L1" "L2" "L3") '("bot" "L1" "L2" "L3")))
                                (T (list '("kind" . "a1") '("w" . 1) '("poles" "L") '("bot" "L"))))))
        (setq dv (append dv (list (cons "model" (gip:model-idn (gip:fmt-model (gip:g b k) (gip:g l "In")) (if (member k '("dif" "dif4")) (gip:g l "idn")) nil)))))
        (setq D (cons dv D)))))
  (reverse D))

;; порядок: общие аппараты — на местах с монтажной схемы, групповые и УЗО — в порядке таблицы
(defun gip:rows-order (s lst / O seq)
  (if (null (gip:g s "order"))
    lst
    (progn
      (setq O (gip:apply-order s lst) seq (vl-remove-if-not '(lambda (x) (gip:g x "row")) lst))
      (mapcar '(lambda (x / y) (if (gip:g x "row") (progn (setq y (car seq) seq (cdr seq)) y) x)) O))))

;; ---------------------------------------------------------------- JSON (запись) — только ASCII
(defun gip:hex4 (n / h d r)
  (setq r "" h "0123456789ABCDEF")
  (repeat 4 (setq d (rem n 16) r (strcat (substr h (1+ d) 1) r) n (/ n 16)))
  r)
(defun gip:js-str (s / r)
  (if (null s) "null"
    (progn
      (setq r "")
      (foreach c (vl-string->list s)
        (setq r (strcat r (cond ((= c 34) "\\\"") ((= c 92) "\\\\") ((or (< c 32) (> c 126)) (strcat "\\u" (gip:hex4 c))) (T (chr c))))))
      (strcat "\"" r "\""))))
(defun gip:js-num (v / s)
  (cond ((null v) "null")
        ((= (type v) 'INT) (itoa v))
        ((not (numberp v)) "null")
        ((equal v (fix v) 1e-9) (itoa (fix v)))
        (T (setq s (rtos v 2 4))
           (while (and (vl-string-search "." s) (= (substr s (strlen s)) "0")) (setq s (substr s 1 (1- (strlen s)))))
           (if (= (substr s (strlen s)) ".") (setq s (substr s 1 (1- (strlen s)))))
           s)))
(defun gip:js-val (v typ)
  (cond ((= typ "s") (gip:js-str (if (= (type v) 'STR) v nil)))
        ((= typ "n") (gip:js-num v))
        ((= typ "i") (if (numberp v) (itoa (fix (+ v (if (minusp v) -0.5 0.5)))) "null"))
        ((= typ "b") (if v "true" "false"))
        (T "null")))
(defun gip:js-obj (al schema / parts)
  (setq parts nil)
  (foreach f schema
    (setq parts (cons (strcat (gip:js-str (car f)) ":" (gip:js-val (gip:g al (car f)) (cdr f))) parts)))
  (strcat "{" (gip:join (reverse parts) ",") "}"))
(setq *gip:js-board* '(("name" . "s") ("tpl" . "s") ("area" . "n") ("phases" . "i") ("inA" . "i") ("inPoles" . "i") ("brand" . "s")
                       ("relay" . "b") ("km" . "b") ("fire" . "b") ("kup" . "b") ("kc" . "n") ("kcMode" . "s") ("pAllowed" . "n")
                       ("mark" . "s") ("railW" . "i") ("mode" . "s") ("kmType" . "s") ("xb" . "b") ("olLen" . "b") ("route" . "s") ("phaseMode" . "s")
                       ("fsHide" . "b") ("fsPre" . "s") ("fsPreIn" . "i") ("fsMeter" . "s") ("fsMeterSpec" . "s") ("fsPost" . "s")
                       ("fsPostIn" . "i") ("fsRcdIn" . "i") ("fsIdn" . "i") ("fsMark" . "s") ("fsCable" . "n")))
(setq *gip:js-g* '(("t" . "s") ("id" . "s") ("cat" . "s") ("name" . "s") ("prot" . "s") ("poles" . "i") ("In" . "i") ("p" . "n") ("idn" . "i")
                   ("phase" . "s") ("lock" . "b") ("cable" . "s") ("len" . "n") ("km" . "b") ("key" . "s") ("pAuto" . "b")))
(setq *gip:js-u* '(("t" . "s") ("id" . "s") ("In" . "i") ("idn" . "i") ("type" . "s") ("poles" . "i") ("phase" . "s") ("lock" . "b")))

;; состояние таблицы (alist board + rows) -> JSON
(defun gip:panel-json (B rows seq)
  (strcat "{\"v\":2,\"seq\":" (itoa seq) ",\"board\":" (gip:js-obj B *gip:js-board*) ",\"rows\":["
          (gip:join (mapcar '(lambda (r) (gip:js-obj r (if (= (gip:g r "t") "u") *gip:js-u* *gip:js-g*))) rows) ",")
          "]}"))

;; щит параметров GIP-ЩИТ (S) -> поля board таблицы
(defun gip:panel-board (S / P)
  (setq P (gip:g S "panel"))
  (foreach kv (list (cons "name" (gip:gn S "board" $S62)) (cons "tpl" (gip:gn S "tpl" "k2")) (cons "area" (gip:gn S "area" 50.0))
                    (cons "phases" (gip:gn S "phases" 1)) (cons "inA" (gip:gn S "inA" 40)) (cons "inPoles" (gip:gn S "inPoles" 3))
                    (cons "brand" (gip:gn S "brand" "abb")) (cons "relay" (gip:g S "relay")) (cons "km" (gip:g S "km"))
                    (cons "fire" (gip:g S "fire")) (cons "kup" T) (cons "kc" (gip:gn S "kc" 0.4)) (cons "railW" (gip:gn S "railW" 18))
                    (cons "xb" (gip:g S "xb")) (cons "olLen" (gip:g S "olLen")) (cons "route" (gip:gn S "route" $S64)) (cons "kmType" (gip:g S "kmType"))
                    (cons "fsHide" (not (gip:g S "floorShield"))))
    (setq P (gip:s P (car kv) (cdr kv))))
  (if (null (gip:g P "kcMode")) (setq P (gip:s P "kcMode" "manual")))
  (if (null (gip:g P "mark")) (setq P (gip:s P "mark" $S98)))
  (if (null (gip:g P "mode")) (setq P (gip:s P "mode" (if (= (gip:g S "prot") "rcd") "rcd" "dif"))))
  (if (null (gip:g P "phaseMode")) (setq P (gip:s P "phaseMode" (gip:gn S "phaseMode" "manual"))))
  P)

;; щит, собранный окном ГИПЩИТ (по шаблону) -> строки таблицы
(defun gip:rows-from-board (S BRD / rows n un d l k rc prot ph rcds)
  (setq rows nil n 0 un 0 rcds nil)
  (foreach d (gip:g BRD "all")
    (setq k (gip:g d "kind"))
    (cond
      ((= k "rcd")
       (setq un (1+ un) rcds (cons (cons (gip:g d "id") (strcat "u" (itoa un))) rcds))
       (setq rows (cons (list '("t" . "u") (cons "id" (strcat "u" (itoa un))) (cons "In" (gip:g d "In")) '("idn" . 30) '("type" . "A") '("poles" . 2)
                              (cons "phase" (if (member (gip:g d "phase") '("L1" "L2" "L3")) (gip:g d "phase") "L1")) '("lock")) rows)))
      ((setq l (gip:g d "line"))
       (setq n (1+ n))
       (setq rc (cond ((= (gip:g l "cat") "light") "light") ((= (gip:g l "cat") "app") (if (= (gip:g l "id") "oven") "oven" "app"))
                      ((= (gip:g l "cat") "custom") "other") (T (gip:g l "cat"))))
       (setq prot (cond ((member k '("dif" "dif4")) "dif") ((and (gip:g d "feed") (gip:starts (gip:g d "feed") "rcd")) "rcd") (T "av")))
       (setq ph (gip:gn l "phase" "L"))
       (setq rows (cons (list '("t" . "g") (cons "id" (strcat "g" (itoa n))) (cons "cat" rc) (cons "name" (gip:g l "name")) (cons "prot" prot)
                              (cons "poles" (gip:g l "poles")) (cons "In" (gip:g l "In")) (cons "p" (gip:g l "p")) '("idn" . 30)
                              (cons "phase" (if (= ph "L123") "L123" ph)) '("lock") (cons "cable" (gip:g (gip:g (gip:g S "edit") (gip:g l "id")) "cable"))
                              '("len") (cons "km" (= (gip:g d "feed") "km"))
                              (cons "key" (if (member (gip:g l "id") '("hob" "oven" "fridge" "dw" "wash" "dry" "heater" "leak")) (gip:g l "id"))))
                        rows)))))
  (list (reverse rows) (+ n un)))

;; JSON таблицы для текущего щита
(defun gip:panel-text (S BRD / x)
  (if (= (gip:g S "v") 2)
    (gip:panel-json (gip:panel-board S) (gip:g S "rows") (max (gip:gn S "seq" 0) (length (gip:g S "rows"))))
    (progn (setq x (gip:rows-from-board S BRD))
           (gip:panel-json (gip:panel-board S) (car x) (cadr x)))))

;; JSON таблицы (разобранный) + прежнее состояние -> состояние GIP-ЩИТ
(defun gip:state-from-panel (j old / B S rows k)
  (setq B (gip:g j "board"))
  (setq S (if (and old (= (gip:g old "v") 2)) old
            (gip:s (gip:s (gip:s (if old old (gip:default-state (gip:gn B "tpl" "k2"))) "order" nil) "breaks" nil) "breakAt" nil)))
  (foreach k '("phases" "inA" "inPoles" "railW") (if (numberp (gip:g B k)) (setq S (gip:s S k (fix (gip:g B k))))))
  (if (= (type (gip:g B "brand")) 'STR) (setq S (gip:s S "brand" (gip:g B "brand"))))
  (foreach k '("relay" "km" "fire" "xb" "olLen") (setq S (gip:s S k (if (gip:g B k) T nil))))
  (setq S (gip:s S "kup" T))
  (setq S (gip:s S "kmType" (if (and (= (type (gip:g B "kmType")) 'STR) (assoc (gip:g B "kmType") *gip:km-types*)) (gip:g B "kmType"))))
  (setq S (gip:s S "route" (if (member (gip:g B "route") *gip:routes*) (gip:g B "route") (car *gip:routes*))))
  (setq S (gip:s S "phaseMode" (if (= (gip:g B "phaseMode") "abc") "abc" "manual")))
  (setq S (gip:s S "mark" (gip:gn B "mark" $S98)))
  ;; этажный щит: настройки из таблицы (пусто — авто)
  (setq S (gip:s S "floorShield" (not (gip:g B "fsHide"))))
  (foreach k '("fsPre" "fsPreIn" "fsMeter" "fsMeterSpec" "fsPost" "fsPostIn" "fsRcdIn" "fsIdn" "fsMark" "fsCable") (setq S (gip:s S k (gip:g B k))))
  (setq S (gip:s S "kc" (gip:num-float (gip:g B "kc") 0.4)))
  (setq S (gip:s S "area" (gip:num-float (gip:g B "area") 50.0)))
  (setq S (gip:s S "board" (gip:gn B "name" $S62)))
  (setq S (gip:s S "tpl" (gip:gn B "tpl" "k2")))
  (setq S (gip:s S "prot" (if (= (gip:g B "mode") "rcd") "rcd" "dif")))
  (setq rows (gip:g j "rows"))
  (setq S (gip:s S "rows" rows) S (gip:s S "v" 2) S (gip:s S "seq" (gip:nz (gip:g j "seq") 0)) S (gip:s S "panel" B))
  ;; для спецификации: помещения освещения (санузлы для КУП) и число линий тёплого пола
  (setq S (gip:s S "light" (mapcar $Q99
                                   (vl-remove-if-not '(lambda (r) (member (gip:g r "cat") '("light"))) rows))))
  (setq S (gip:s S "floor" (length (vl-remove-if-not '(lambda (r) (= (gip:g r "cat") "floor")) rows))))
  S)

;; ---------------------------------------------------------------- обмен с панелью
(setq *gip:panel-file* "gip_panel_in.json")
(defun gip:read-file (fn / f l s)
  (if (and fn (findfile fn) (setq f (open fn "r")))
    (progn (setq s "")
           (while (setq l (read-line f)) (setq s (strcat s l)))
           (close f) s)))
(defun gip:panel-save (S BRD)
  (gip:dict-put "GIPPANEL" (if *gip:panel-raw* *gip:panel-raw* (gip:panel-text S BRD)))
  (setq *gip:panel-raw* nil))

;; панель -> чертёж: таблица записана в TEMPPREFIX\gip_panel_in.json, строим альбом
(defun c:GIPPANELAPPLY (/ txt j S)
  (setq txt (gip:read-file (strcat (getvar "TEMPPREFIX") *gip:panel-file*)))
  (if (and txt (setq j (vl-catch-all-apply 'gip:json (list txt))) (not (vl-catch-all-error-p j)) (assoc "board" j))
    (progn
      (setq S (gip:state-from-panel j (gip:load-state)))
      (setq *gip:panel-raw* txt)
      (gip:run S)
      (setq *gip:panel-raw* nil))
    (princ $S100))
  (princ))

;; чертёж с щитом, собранным раньше окном ГИПЩИТ, -> таблица для панели (без перестроения)
(defun gip:panel-export (/ S)
  (if (and (null (gip:dict-get "GIPPANEL")) (setq S (gip:load-state)))
    (progn (setq *gip:b* (gip:brand (gip:g S "brand")))
           (gip:dict-put "GIPPANEL" (gip:panel-text S (gip:board S)))))
  (princ))

;; ---------------------------------------------------------------- монтажная схема -> строки таблицы
;; порядок УЗО-блоков и свободных групп — по месту их аппаратов на рейках; группы внутри блока — по своим местам.
;; items — аппараты монтажной схемы по порядку (id рейка x номинал)
(defun gip:rows-from-montage (S items / pos p rows units cur kill r id out cu)
  (setq pos nil p 0)
  (foreach it items (setq pos (cons (cons (car it) p) pos) p (1+ p)))
  (setq rows (gip:g S "rows") units nil cur nil kill nil)
  ;; удалённые с монтажной схемы аппараты
  (foreach r rows
    (setq id (gip:g r "id"))
    (if (null (assoc (if (= (gip:g r "t") "u") (strcat "rcd:" id) (strcat "L:" id)) pos)) (setq kill (cons id kill))))
  ;; единицы порядка: (место строка-УЗО-или-группа группы-блока)
  (foreach r rows
    (cond ((member (gip:g r "id") kill)
           (if (= (gip:g r "t") "u") (setq cur nil)))
          ((= (gip:g r "t") "u")
           (setq units (cons (list (cdr (assoc (strcat "rcd:" (gip:g r "id")) pos)) r nil) units) cur T))
          ((and cur (= (gip:g r "prot") "rcd"))
           (setq cu (car units) units (cons (list (car cu) (cadr cu) (append (caddr cu) (list r))) (cdr units))))
          (T
           (setq cur nil)
           (if (= (gip:g r "prot") "rcd") (setq r (gip:s r "prot" (if (member (gip:g r "cat") '("light" "elight" "hob" "ac" "reserve")) "av" "dif"))))
           (setq units (cons (list (cdr (assoc (strcat "L:" (gip:g r "id")) pos)) r nil) units)))))
  (setq units (gip:msort (reverse units) '(lambda (a b) (< (car a) (car b)))))
  (setq out nil)
  (foreach u units
    (setq out (append out (list (cadr u))))
    (if (caddr u)
      (setq out (append out (gip:msort (caddr u) '(lambda (a b) (< (cdr (assoc (strcat "L:" (gip:g a "id")) pos)) (cdr (assoc (strcat "L:" (gip:g b "id")) pos)))))))))
  ;; номиналы, исправленные на монтажной схеме
  (mapcar '(lambda (r / it In)
             (if (and (= (gip:g r "t") "g") (setq it (assoc (strcat "L:" (gip:g r "id")) items)) (setq In (gip:parse-in (nth 3 it))) (/= In (gip:g r "In")))
               (gip:s (gip:s r "In" In) "cable" nil)
               r)) out))
;;; ============================================================================
;;; Построение объектов: прототипы из рабочих файлов ГИП, сдвиг, правка текста,
;;; вставка динамических блоков по имени с видимостью и атрибутами
;;; ============================================================================
(setq *gip:app* "GIPGEN")          ; метка созданных объектов (xdata)
(setq *gip:dev-app* "GIPDEV")      ; метка аппаратов монтажной схемы (id аппарата)

;; углы TEXT/ATTDEF (поворот 50, наклон 51) и ARC (50, 51) в файлах ГИП записаны в градусах,
;; а entmake ждёт радианы (MTEXT 50 — уже радианы, вставки "I" пересчитывает gip:ins)
(defun gip:deg-fix (it / typ)
  (if (and (= (car it) "E") (member (setq typ (cdr (assoc 0 (cdr it)))) '("TEXT" "ATTDEF" "ARC")))
    (cons "E" (mapcar '(lambda (p) (if (and (member (car p) '(50 51)) (numberp (cdr p))) (cons (car p) (* (cdr p) (/ pi 180.0))) p)) (cdr it)))
    it))
(defun gip:protos ()
  (if (null *gip:protos*)
    (setq *gip:protos* (mapcar '(lambda (pr) (cons (car pr) (mapcar 'gip:deg-fix (cdr pr)))) (gip:deep-u *gip:protos-raw*))))
  *gip:protos*)
(defun gip:proto (name / p)
  (if (setq p (assoc name (gip:protos))) (cdr p) (progn (princ (strcat $S101 name)) nil)))

;; ---------------------------------------------------------------- сдвиг
(defun gip:shift-pt (p dx dy) (append (list (car p) (+ (cadr p) dx) (+ (caddr p) dy)) (cdddr p)))

(defun gip:shift-data (data dx dy / typ out firstH edge c)
  (setq typ (cdr (assoc 0 data)) out nil firstH T edge nil)
  (foreach p data
    (setq c (car p))
    (cond
      ((= typ "HATCH")
       (cond ((and (= c 10) (listp (cdr p)) firstH) (setq firstH nil out (cons p out)))
             ((and (= c 10) (listp (cdr p))) (setq out (cons (gip:shift-pt p dx dy) out)))
             ((= c 72) (setq edge (cdr p) out (cons p out)))
             ((and (= c 11) (listp (cdr p)) (= edge 1)) (setq out (cons (gip:shift-pt p dx dy) out)))
             (T (setq out (cons p out)))))
      ((and (= c 10) (listp (cdr p)) (member typ '("LINE" "LWPOLYLINE" "CIRCLE" "ARC" "ELLIPSE" "TEXT" "MTEXT" "SOLID" "POINT")))
       (setq out (cons (gip:shift-pt p dx dy) out)))
      ((and (= c 11) (listp (cdr p)) (member typ '("LINE" "TEXT" "SOLID")))
       (setq out (cons (gip:shift-pt p dx dy) out)))
      ((and (member c '(12 13)) (listp (cdr p)) (= typ "SOLID"))
       (setq out (cons (gip:shift-pt p dx dy) out)))
      (T (setq out (cons p out)))))
  (reverse out))

(defun gip:shift-item (it dx dy)
  (if (= (car it) "E")
    (cons "E" (gip:shift-data (cdr it) dx dy))
    (append (list (nth 0 it) (nth 1 it) (+ (nth 2 it) dx) (+ (nth 3 it) dy)) (gip:drop it 4))))

;; ---------------------------------------------------------------- правка данных
(defun gip:dset (data c v / p)
  (if (setq p (assoc c data)) (subst (cons c v) p data) (append data (list (cons c v)))))
(defun gip:dget (data c) (cdr (assoc c data)))
(defun gip:it-set (it c v) (cons "E" (gip:dset (cdr it) c v)))
(defun gip:it-get (it c) (gip:dget (cdr it) c))
(defun gip:it-type (it) (if (= (car it) "E") (gip:it-get it 0) "INSERT"))

;; экранирование текста MTEXT
(defun gip:mt-esc (s)
  (gip:repl (gip:repl (gip:repl (gip:repl s "\\" "\\\\") "{" "\\{") "}" "\\}") "\n" "\\P"))

;; содержимое MTEXT: префикс форматирования до последней ';' + текст + закрывающие скобки
(defun gip:mt-wrap (full text / i n pre post c)
  (setq n (strlen full) post "")
  (while (and (> n 0) (= (substr full n 1) "}")) (setq post (strcat post "}") n (1- n)))
  (setq pre "" i n)
  (while (> i 0)
    (if (and (= pre "") (= (substr full i 1) ";")) (setq pre (substr full 1 i)))
    (setq i (1- i)))
  (strcat pre (gip:mt-esc text) post))

(defun gip:it-text (it text / data typ full val chunks)
  (setq data (cdr it) typ (cdr (assoc 0 data)))
  (if (/= typ "MTEXT")
    (gip:it-set it 1 text)
    (progn
      (setq full "")
      (foreach p data (if (= (car p) 3) (setq full (strcat full (cdr p)))))
      (setq full (strcat full (gip:dget data 1)))
      (setq val (gip:mt-wrap full text))
      (gip:mt-set it val))))

;; записать готовое содержимое MTEXT (длинное — кусками по 250 в код 3)
(defun gip:mt-set (it val / data before after chunks seen)
  (setq data (vl-remove-if '(lambda (p) (= (car p) 3)) (cdr it)))
  (setq chunks nil)
  (while (> (strlen val) 250) (setq chunks (append chunks (list (cons 3 (substr val 1 250)))) val (substr val 251)))
  (setq before nil after nil seen nil)
  (foreach p data
    (cond ((= (car p) 1) (setq seen T))
          (seen (setq after (append after (list p))))
          (T (setq before (append before (list p))))))
  (cons "E" (append before chunks (list (cons 1 val)) after)))

(defun gip:it-line (it x1 y1 x2 y2 / d)
  (setq d (gip:dset (cdr it) 10 (list x1 y1 0.0)))
  (setq d (subst (list 10 x1 y1 0.0) (assoc 10 d) d))
  (setq d (subst (list 11 x2 y2 0.0) (assoc 11 d) d))
  (cons "E" d))

;; вершины полилинии: pts — плоский список x y x y ...
(defun gip:it-poly (it pts / data head tail mid n firstSeen k)
  (setq data (cdr it) head nil tail nil firstSeen nil)
  (foreach p data
    (cond ((member (car p) '(10 40 41 42 91))
           (setq firstSeen T))
          ((not firstSeen) (setq head (append head (list p))))
          (T (setq tail (append tail (list p))))))
  (setq mid nil k 0)
  (while (< k (length pts)) (setq mid (append mid (list (list 10 (nth k pts) (nth (1+ k) pts)))) k (+ k 2)))
  (setq head (subst (cons 90 (/ (length pts) 2)) (assoc 90 head) head))
  (cons "E" (append head mid tail)))

;; атрибуты вставки: в элементе "I" — список (тег . значение)
(defun gip:it-att (it tag val / atts)
  (if (= (car it) "I")
    (progn
      (setq atts (nth 12 it))
      (setq atts (if (assoc tag atts)
                   (mapcar '(lambda (a) (if (= (car a) tag) (cons tag val) a)) atts)
                   (append atts (list (cons tag val)))))
      (append (gip:take it 12) (list atts)))
    it))
(defun gip:it-atts (it pairs) (foreach p pairs (setq it (gip:it-att it (car p) (cdr p)))) it)

;; ---------------------------------------------------------------- создание
(defun gip:tag-list (tag) (list (list -3 (list *gip:app* (cons 1000 tag)))))

(defun gip:mk (data tag / e)
  (setq e (entmakex (append data (gip:tag-list tag))))
  (if (null e) (princ (strcat $S102 (vl-princ-to-string (cdr (assoc 0 data))))))
  e)

(defun gip:ms ()
  (if (null *gip:ms*) (setq *gip:ms* (vla-get-modelspace (vla-get-activedocument (vlax-get-acad-object)))))
  *gip:ms*)

(defun gip:layer (name)
  (if (not (tblsearch "LAYER" name))
    (entmakex (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 name) '(70 . 0) '(62 . 7) '(6 . "Continuous"))))
  name)

(defun gip:set-dyn (obj name val / props r)
  (setq props (vl-catch-all-apply 'vlax-invoke (list obj 'GetDynamicBlockProperties)))
  (if (not (vl-catch-all-error-p props))
    (foreach p props
      (if (= (strcase (vlax-get p 'PropertyName)) (strcase name))
        (progn
          (setq r (vl-catch-all-apply 'vlax-put (list p 'Value val)))
          (if (vl-catch-all-error-p r) (princ (strcat $S103 name " = " (vl-princ-to-string val) ": " (vl-catch-all-error-message r)))))))))

(defun gip:set-atts (obj pairs / atts)
  (setq atts (vl-catch-all-apply 'vlax-invoke (list obj 'GetAttributes)))
  (if (not (vl-catch-all-error-p atts))
    (foreach a atts
      (foreach p pairs
        (if (= (strcase (vlax-get a 'TagString)) (strcase (car p)))
          (vlax-put a 'TextString (cdr p)))))))

(defun gip:visprop (name)
  (cond ((member name $Q104) $S105)
        ((= name $S106) $S107)
        ((= name "NUM-POM_GIP") "Visibility1")
        ((= name $S108) $S109)
        (T "Visibility")))

;; видимость: свойство, в списке значений которого есть нужное состояние (имя параметра не важно)
(defun gip:set-vis (obj name val / props done av r)
  (setq props (vl-catch-all-apply 'vlax-invoke (list obj 'GetDynamicBlockProperties)) done nil)
  (if (not (vl-catch-all-error-p props))
    (foreach p props
      (if (not done)
        (progn
          (setq av (vl-catch-all-apply 'vlax-get (list p 'AllowedValues)))
          (if (and (listp av) (member val av))
            (progn (setq r (vl-catch-all-apply 'vlax-put (list p 'Value val)) done T)
                   (if (vl-catch-all-error-p r) (princ (strcat "\nGIP: " name $S110 val $S111 (vl-catch-all-error-message r))))))))))
  (if (not done) (gip:set-dyn obj (gip:visprop name) val)))

;; вставка: ("I" имя x y sx sy rot° слой цвет масштаб_типа_линий видимость (свойства) (атрибуты))
(defun gip:ins (it tag / obj e ed name)
  (setq name (nth 1 it))
  (if (not (tblsearch "BLOCK" name))
    (progn (princ (strcat $S112 name $S113)) nil)
    (progn
      (setq obj (vla-insertblock (gip:ms) (vlax-3d-point (nth 2 it) (nth 3 it) 0.0) name (nth 4 it) (nth 5 it) (abs (nth 5 it)) (* (nth 6 it) (/ pi 180.0))))
      (gip:layer (nth 7 it))
      (foreach p (nth 11 it) (gip:set-dyn obj (car p) (cdr p)))
      (if (nth 10 it) (gip:set-vis obj name (nth 10 it)))
      (if (nth 12 it) (gip:set-atts obj (nth 12 it)))
      ;; слой, цвет, масштаб типа линий и метка — одной правкой
      (setq e (vlax-vla-object->ename obj) ed (entget e))
      (setq ed (gip:dset ed 8 (nth 7 it)))
      (if (nth 8 it) (setq ed (gip:dset ed 62 (nth 8 it))))
      (if (nth 9 it) (setq ed (gip:dset ed 48 (nth 9 it))))
      (entmod (append ed (gip:tag-list tag)))
      obj)))

(defun gip:emit (items tag / r)
  (setq r nil)
  (foreach it items
    (setq r (cons (if (= (car it) "E") (gip:mk (cdr it) tag) (gip:ins it tag)) r)))
  (reverse r))

;; place: прототип, сдвиг, правка (функция от списка элементов), создание
(defun gip:place (name dx dy fn / items)
  (setq items (mapcar '(lambda (it) (gip:shift-item it dx dy)) (gip:proto name)))
  (if fn (setq items (apply fn (list items))))
  (gip:emit items *gip:tag*))

;; MTEXT по прототипу с текстом и правками (o: ("w" . ширина) ("h" . высота) ("att" . привязка))
(defun gip:mt (proto x y text o / it)
  (gip:place proto x y
    (list 'lambda '(its / it)
      (list 'setq 'it '(car its))
      (if text (list 'setq 'it (list 'gip:it-text 'it text)))
      (if (assoc "w" o) (list 'setq 'it (list 'gip:it-set 'it 41 (float (cdr (assoc "w" o))))))
      (if (assoc "h" o) (list 'setq 'it (list 'gip:it-set 'it 40 (float (cdr (assoc "h" o))))))
      (if (assoc "att" o) (list 'setq 'it (list 'gip:it-set 'it 71 (cdr (assoc "att" o)))))
      '(cons it (cdr its)))))

(defun gip:W (x1 y1 x2 y2)
  (gip:place "wire" 0.0 0.0 (list 'lambda '(its) (list 'list (list 'gip:it-line '(car its) x1 y1 x2 y2)))))
(defun gip:PL (pts proto)
  (gip:place (if proto proto "wire0") 0.0 0.0 (list 'lambda '(its) (list 'list (list 'gip:it-poly '(car its) (list 'quote pts))))))
(defun gip:dot (x y big) (gip:place (if big "dot43" "dot41") x y nil))
