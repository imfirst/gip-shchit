(setq *gip:KU* 49.907)
(setq *gip:C0* 3631.0 *gip:PITCH* 785.4)
(setq *gip:YB_L* -1348.267 *gip:YB_N* -1437.39 *gip:YB_PE* -1527.18 *gip:YB_LB* -1619.82)
(setq *gip:YDEV* -1996.65 *gip:YDB* -2614.5 *gip:YKN* -2751.8 *gip:YMG* -2989.8)
(setq *gip:YT* '(-4547.0 -5144.0 -5442.0 -5740.0 -7075.0))

(defun gip:short-type (tpl / t1 p)
  ;; "S201 C{I}" -> "S201"; "ВА47-29 1Р C{I}" -> "ВА47-29"
  (setq t1 tpl)
  (if (setq p (vl-string-search " C{I}" t1)) (setq t1 (substr t1 1 p)))
  (if (setq p (vl-string-search "C{I}" t1)) (setq t1 (substr t1 1 p)))
  (if (setq p (vl-string-search " {I}" t1)) (setq t1 (substr t1 1 p)))
  (setq t1 (gip:trim t1))
  (foreach suf $Q114
    (if (gip:ends t1 suf) (setq t1 (substr t1 1 (- (strlen t1) (strlen suf))))))
  (gip:trim t1))

(defun gip:brand-ser (b kind In / tpl st)
  (setq tpl (gip:g b kind))
  (cond ((null tpl) "")
        ((= (substr kind 1 1) "a") (setq st (gip:short-type tpl)) (if (= (gip:g b "name") "ABB") (strcat st "C") st))
        ((member kind '("dif" "dif4")) (gip:short-type tpl))
        (T (gip:fmt-model tpl In))))
(defun gip:rcd-ser (tpl / p t1)
  (setq t1 tpl)
  (if (setq p (vl-string-search "{I}" t1)) (setq t1 (substr t1 1 p)))
  (setq t1 (vl-string-right-trim "- " t1))
  (gip:short-type t1))

;; марка кабеля в узкой колонке схемы: без «(А)» и дефиса — «ВВГнгLS», «ППГнгHF»
(defun gip:mark-short (m) (gip:repl (gip:repl (gip:repl m $S115 "") "(A)" "") "-" ""))
;; марка контактора -> две строки надписи: «ESB» + «25-40N», «КМ63-40М» + «25А», «NCH8» + «25/40»
(defun gip:km-split (m / p)
  (cond ((gip:starts m "ESB") (list "ESB" (substr m 4)))
        ((setq p (vl-string-search " " m)) (list (substr m 1 p) (gip:trim (substr m (+ p 2)))))
        ((setq p (vl-string-search "-" m)) (list (substr m 1 p) (substr m (+ p 2))))
        (T (list m ""))))
(defun gip:in-cable (In is3 / sq) (setq sq (cond ((<= In 25) 6) ((<= In 40) 10) (T 16))) (strcat $S116 (if is3 "5" "3") "x" (itoa sq)))
(defun gip:conduit (cab / sq p)
  (setq sq 2.5)
  (if (setq p (vl-string-search $S94 cab)) (setq sq (atof (gip:repl (substr cab (+ p 2)) "," "."))))
  (cond ((<= sq 1.5) $S117) ((<= sq 2.5) $S118) ((<= sq 6.0) $S119) (T $S120)))
(defun gip:next-in (v lst / r) (setq r nil) (foreach x lst (if (and (null r) (> x v)) (setq r x))) (if r r (last lst)))

(defun gip:consumer (l / nm wet)
  (setq nm (gip:lower (gip:gn l "name" "")))
  (cond ((= (gip:g l "cat") "light") '("c_svet" -4352.0 -4224.0))
        ((= (gip:g l "cat") "floor") '("c_tp" -4381.0 -4311.0))
        ((or (member (gip:g l "cat") '("sock" "app")) (and (= (gip:g l "cat") "custom") (/= (gip:g l "poles") 3)))
         (if (= (gip:gn l "key" (gip:g l "id")) "oven")
           '("c_kab" -4311.0 -4311.0)
           (progn
             (setq wet (or (gip:has nm $S121) (gip:has nm $S122) (gip:has nm $S123) (gip:has nm $S124) (gip:has nm $S125)
                           (member (gip:gn l "key" (gip:g l "id")) '("wash" "dw" "dry"))))
             (if wet '("c_roz44" -4311.0 -4311.0) '("c_roz" -4311.0 -4311.0)))))
        (T '("c_kab" -4311.0 -4311.0))))

(defun gip:inom (l / cc) (setq cc (gip:cos l))
  (if (= (gip:g l "poles") 3) (/ (gip:g l "p") (* (sqrt 3.0) 0.4 cc)) (/ (gip:g l "p") (* 0.23 cc))))

;; видимость вставки "I" (элемент 10)
(defun gip:it-vis (it v) (if (and v (= (car it) "I") (nth 10 it)) (append (gip:take it 10) (list v) (gip:drop it 11)) it))
;; видимость блока «аппарат управления и защиты в РЩ» по числу полюсов
(defun gip:av-vis (n) (strcat $S126 (nth (max 0 (min 3 (1- n))) $Q127)))
(defun gip:rcd-vis (four) (if four $S128 $S129))
;; атрибуты аппарата на схеме
(defun gip:dev-atts (its d o)
  (mapcar $Q130
          its))

;; колонки однолинейки и разбивка на листы по 19
(defun gip:ol-pages (B kup / cols nLO nLS pages cur i c need j CAP)
  (setq cols nil nLO 0 nLS 0 CAP 19)
  (foreach d (gip:g B "all")
    (cond ((= (gip:g d "kind") "rcd") (setq cols (cons (list '("t" . "rcd") (cons "d" d)) cols)))
          ((gip:g d "line")
           (cond ((gip:g (gip:g d "line") "num") (setq cols (cons (list '("t" . "line") (cons "d" d) (cons "no" (gip:g (gip:g d "line") "num"))) cols)))
                 ((= (gip:g (gip:g d "line") "cat") "light")
                  (setq nLO (1+ nLO) cols (cons (list '("t" . "line") (cons "d" d) (cons "no" (strcat $S131 (itoa nLO)))) cols)))
                 (T (setq nLS (1+ nLS) cols (cons (list '("t" . "line") (cons "d" d) (cons "no" (strcat $S132 (itoa nLS)))) cols)))))))
  (setq cols (reverse cols) pages nil cur nil i 0)
  (while (< i (length cols))
    (setq c (nth i cols) need 1)
    (if (= (gip:g c "t") "rcd")
      (progn (setq j (1+ i))
             (while (and (< j (length cols)) (= (gip:g (gip:g (nth j cols) "d") "feed") (gip:g (gip:g c "d") "id"))) (setq need (1+ need) j (1+ j)))))
    (if (and (> (+ (length cur) need) CAP) cur) (setq pages (append pages (list cur)) cur nil))
    (setq cur (append cur (list c)) i (1+ i)))
  (setq pages (append pages (list cur)))
  (if (and kup (>= (length (last pages)) CAP)) (setq pages (append pages (list nil))))
  pages)

;; ---------------------------------------------------------------- этажный щит
;; Настройки (поля fs* таблицы; пусто — авто). Селективность: автомат после счётчика — на ступень больше вводного
;; квартиры, УЗО — на ступень больше автомата, рубильник/автомат перед счётчиком — на ступень больше; при УЗО 100 мА
;; в квартире ток утечки в этажном щите — 300 мА.
(setq *gip:fs-brk* '(16 20 25 32 40 50 63 80 100 125) *gip:fs-qs* '(25 32 40 50 63 80 100 125) *gip:fs-rcd* '(25 40 63 80 100))
(defun gip:fs-int (S k) (if (numberp (gip:g S k)) (fix (gip:g S k))))
(defun gip:fs-str (S k) (if (and (= (type (gip:g S k)) 'STR) (/= (gip:trim (gip:g S k)) "")) (gip:trim (gip:g S k))))
(defun gip:sec-str (v) (if (equal v (fix v) 1e-9) (itoa (fix v)) (gip:repl (rtos v 2 1) "." ",")))
(defun gip:fs-cfg (S / is3 inA post postIn rcdIn idn pre preIn mark al sec)
  (setq is3 (= (gip:g S "phases") 3) inA (gip:gn S "inA" 40))
  (setq post (if (member (gip:g S "fsPost") '("av" "dif" "avrcd")) (gip:g S "fsPost") (if is3 "dif" "av")))
  (setq postIn (cond ((gip:fs-int S "fsPostIn")) (T (gip:next-in inA *gip:fs-brk*))))
  (setq rcdIn (if (= post "avrcd") (cond ((gip:fs-int S "fsRcdIn")) (T (gip:next-in postIn *gip:fs-rcd*)))))
  (setq idn (if (/= post "av") (cond ((gip:fs-int S "fsIdn")) ((gip:g S "fire") 300) (T 100))))
  (setq pre (if (= (gip:g S "fsPre") "qf") "qf" "qs"))
  (setq preIn (cond ((gip:fs-int S "fsPreIn")) (T (gip:next-in postIn (if (= pre "qs") *gip:fs-qs* *gip:fs-brk*)))))
  (setq mark (cond ((gip:fs-str S "fsMark")) ((gip:fs-str S "mark")) (T $S98)))
  (setq al (member (substr mark 1 1) $Q133))
  (setq sec (cond ((numberp (gip:g S "fsCable")) (gip:g S "fsCable"))
                  (al (cond ((<= inA 40) 16) ((<= inA 63) 25) (T 35)))
                  (T (cond ((<= inA 25) 6) ((<= inA 40) 10) (T 16)))))
  (list (cons "post" post) (cons "postIn" postIn) (cons "rcdIn" rcdIn) (cons "idn" idn) (cons "pre" pre) (cons "preIn" preIn)
        (cons "meter" (cond ((gip:fs-str S "fsMeter")) (is3 $S134) (T $S135)))
        (cons "meterSpec" (cond ((gip:fs-str S "fsMeterSpec")) (is3 $S136) (T $S137)))
        (cons "cable" (strcat mark " " (if is3 "5" "3") "x" (gip:sec-str sec)))))

